# Same-model Fedora charging source, alternative to the old ADC diagnostic.
# Direct charging remains opt-in and disabled at normal boot.
CONFIG_CHARGER_SM5440_FEDORA=y
# CONFIG_CHARGER_SM5440_DIRECT is not set
# CONFIG_X710_CHARGING_POLICY is not set
# CONFIG_X710_NATIVE_CONTROL is not set
# CONFIG_SM5440_ADC_CONDITION_TEST is not set
# CONFIG_SM5440_ADC_TIMING_TEST is not set
# CONFIG_SM5440_ADC_RAW_TEST is not set
# CONFIG_SM5440_ADC_ONESHOT_TEST is not set
