# Samsung Galaxy Tab S9 Wi-Fi (SM-X710 / gts9wifi) early mainline fragment.
# Keep this file limited to upstream Kconfig symbols. Out-of-tree subsystem
# drivers are added later with the patch/driver that defines their symbol.

# Early boot and diagnostics.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# The GENI serial port itself stays built in: the SE block is shared IP, the port
# is still registered and /dev/ttyMSM0 still exists.  Only its *console* is off.
CONFIG_SERIAL_QCOM_GENI=y
# Deliberately off, and stated here rather than only in the console section below,
# because this line used to read `=y`.  merge_config.sh resolves duplicates
# last-wins, so the old `=y` here and the `is not set` further down disagreed and
# the winner depended on file order - exactly the kind of thing that silently
# reverts a setting.  build-kernel.sh asserts the resolved value either way.
# CONFIG_SERIAL_QCOM_GENI_CONSOLE is not set
CONFIG_PRINTK_TIME=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# Primary persistent log channel for the first boot test: the kernel console is
# written into Samsung's sec_log_buf ring, which TWRP/recovery exposes as
# /proc/last_kmsg after a warm reset.  Built in, because it must exist before
# any root filesystem is available (driver: kernel/drivers/, patch 0002).
CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PM_DEBUG=y
# Preserve a panic for inspection instead of inheriting stock's immediate
# reboot (PANIC_TIMEOUT=-1). Firmware watchdog resets are independent of this.
CONFIG_PANIC_TIMEOUT=0
# The boot bundle uses legacy LZ4 for both ramdisks.
CONFIG_RD_LZ4=y

# Root storage: both internal UFS and microSD must work without modules.
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_EFI_PARTITION=y

# SM8550 platform plumbing used by several early providers.
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_LLCC=y
# AOSS QMP. The SM8550 device tree wires gmu@3d6a000 to aoss_qmp
# (qcom,qmp = <&aoss_qmp>), because a6xx_gmu_acd_probe() has to tell AOSS
# whether GPU adaptive clock distribution is enabled. Upstream sm8550.dtsi
# gives all eight GPU OPP nodes a qcom,opp-acd-level, so cmd->enable_by_level
# is always non-zero on this board and the driver takes its
#     if (cmd->enable_by_level && IS_ERR_OR_NULL(gmu->qmp))
# branch. Without this symbol no driver binds to power-management@c300000,
# qmp_get() returns -EPROBE_DEFER forever (the node exists, its drvdata does
# not), and a6xx_gmu_init() aborts with "Unable to send ACD state to AOSS" ->
# -EINVAL. The GPU then never binds, and the cxpd device-link teardown on that
# error path raises the "Unable to drop a managed device link reference"
# warning. The X910 port sets this symbol and does not show the failure; see
# docs/GPU_GMU_RPMH_STALL_PLAN.md and docs/X710_X910_GPU_RPMH_DIFF.md.
CONFIG_QCOM_AOSS_QMP=y
# IPCC. aoss_qmp's device node takes its mailbox from the IPCC controller
# (mboxes = <&ipcc IPCC_CLIENT_AOP IPCC_MPROC_SIGNAL_GLINK_QMP>), so
# CONFIG_QCOM_AOSS_QMP alone is NOT enough: without this symbol the IPCC node
# mailbox@408000 has no driver, the mailbox controller is never registered, and
# qcom_aoss_qmp fails its own probe with
#     qcom_aoss_qmp c300000.power-management: failed to acquire ipc mailbox
# which leaves qmp_get() returning -EPROBE_DEFER exactly as if AOSS QMP were
# still disabled. Measured on hardware: with only CONFIG_QCOM_AOSS_QMP=y the
# GPU/GMU stayed unbound. X910 sets BOTH (config-mainline.aarch64:
# CONFIG_QCOM_IPCC=y and CONFIG_QCOM_AOSS_QMP=y).
#
# IPCC is also an interrupt controller, hence the IRQ_DOMAIN* / GENERIC_IRQ_CHIP
# dependencies, which this fragment already satisfies.
CONFIG_QCOM_IPCC=y
# Qualcomm hardware mutex (TCSR). Upstream sm8550.dtsi gives the SMEM node a
# hwlock from this provider:
#     smem: smem@81d00000 { hwlocks = <&tcsr_mutex 3>; };
# and the node itself is in the DTB (hwlock@1f40000, "qcom,tcsr-mutex"). Without
# this symbol no driver binds to it, of_hwspin_lock_get_id() returns
# -EPROBE_DEFER, and qcom_smem_probe() fails its own probe with
#     platform 81d00000.smem: deferred probe pending: qcom-smem: failed to retrieve hwlock
# That blocked four devices permanently on hardware (measured, 860 s uptime):
#   81d00000.smem.qcom-smem: failed to retrieve hwlock
#   smp2p-adsp.qcom_smp2p: unable to allocate local smp2p item
#   smp2p-cdsp.qcom_smp2p: unable to allocate local smp2p item
#   smp2p-modem.qcom_smp2p: unable to allocate local smp2p item
#   -> 6800000.remoteproc.platform: wait for supplier /smp2p-adsp/slave-kernel
# i.e. an uninitialised SMEM cascades into the smp2p devices and then into the
# ADSP remoteproc. X910 sets this (config-mainline.aarch64: CONFIG_HWSPINLOCK_QCOM=y);
# X710 had neither it nor CONFIG_HWSPINLOCK_OMAP. CONFIG_HWSPINLOCK alone is not
# enough - it is the provider that must bind.
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8550=y
# EPSS L3, the third interconnect provider on the CPU path. Measured on hardware
# (860 s uptime, post-AOSS/IPCC-fix image):
#   platform 17d91000.cpufreq: deferred probe pending:
#       qcom-cpufreq-hw: Failed to find icc paths
#   gcc-sm8550 100000.clock-controller: sync_state() pending due to 17d91000.cpufreq
# qcom-cpufreq-hw resolves the interconnect paths its CPU nodes name before it
# registers anything, and cpu0 names THREE providers:
#   interconnects = <&gem_noc MASTER_APPSS_PROC ... &gem_noc SLAVE_LLCC ...>,
#                   <&mc_virt MASTER_LLCC ... &mc_virt SLAVE_EBI1 ...>,
#                   <&epss_l3 MASTER_EPSS_L3_APPS &epss_l3 SLAVE_EPSS_L3_SHARED>;
# The first two bind to qnoc-sm8550 via CONFIG_INTERCONNECT_QCOM_SM8550, which is
# why every "all providers are bound" audit missed this: the missing one has no
# unit address in that list. The third is 17d90000.interconnect,
# compatible = "qcom,sm8550-epss-l3", "qcom,epss-l3", driven only by
# INTERCONNECT_QCOM_OSM_L3. Upstream arch/arm64/configs/defconfig sets it to =m;
# this port builds no module tree, so =m produces no driver at all,
# of_icc_get_by_index(cpu_dev, 2) returns -EPROBE_DEFER forever, and because
# dev_err_probe() logs -EPROBE_DEFER at debug level the outer
# "Failed to find icc paths" is the ONLY message - "Unable to get path2" never
# appears. Result: no cpufreq policy on any cluster, no schedutil, a fixed
# firmware-left OPP on all eight cores, and gcc's sync_state() blocked for the
# life of the boot.
#
# X910 hit exactly this and diagnosed it: docs/development-notes.md "There was no
# frequency scaling at all" names the same phandles (gem-noc 0x7, mc-virt 0x8,
# epss-l3 0x9, "none" driver) and the same =m trap; kernel/config/
# config-ubuntu-desktop.fragment fixes it the same way, and with =y X910 reports
# three policies (307-2016 / 499-2803 / 595-2956 MHz), schedutil and an energy
# model. This is the CPU-path instance of the same defect class as the four
# providers above.
#
# The generic "qcom,epss-l3" match is the one that applies: osm-l3's
# osm_l3_of_match[] has no sm8550-specific entry, so the fallback selects
# epss_l3_l3_vote (EPSS_REG_L3_VOTE = 0x90), which is what SM8550 wants.
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_8550=y
CONFIG_SM_GPUCC_8550=y
CONFIG_SM_DISPCC_8550=y
CONFIG_PINCTRL_SM8550=y
# Was PINCTRL_SPMI_PMIC in 5.15; renamed upstream and still required for the
# PM8550/PMK8550 GPIO and MPP blocks used by the board DTS.
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y

# Display/GPU. The board DTS may still require device-specific panel work, but
# the upstream MSM/DPU/Adreno side should be built into early test kernels.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# USB rescue path and Type-C core.
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
# --- No serial function on the gadget (2026-09-26) --------------------------
#
# The gadget is exactly one function: NCM, the network ssh is reached over.  The
# serial functions are removed from the *build*, not merely left unused, so that
# no configfs `acm.usb0` can be created even by hand:
#
#   USB_CONFIGFS_ACM    -> "acm.usb0", the last port.  It was reached only by
#                          opening a terminal on the host AND starting a reader on
#                          the tablet, nothing on the tablet ever wrote to it, and
#                          the kernel log did not come out of it.  The login is now
#                          the ssh key written into the rootfs at install time
#                          (install-debian-rootfs.sh --ssh-key).
#   USB_CONFIGFS_SERIAL -> "gser.usb0", the generic u_serial function.  Never used
#                          by this port, but it selects CONFIG_USB_U_SERIAL and is
#                          the other way to get a ttyGS port, so it goes with it.
#
# CONFIG_USB_U_SERIAL is the shared u_serial core.  It is *selected* by the two
# symbols above rather than requested directly, so with both off it disappears on
# its own - and that is what makes CONFIG_U_SERIAL_CONSOLE unsatisfiable, which is
# the property the console removal depends on (see the console section below).
#
# CONFIG_USB_F_ACM / CONFIG_USB_F_SERIAL likewise drop out via their selects.
#
# CONFIG_USB_ACM is NOT this.  It is the *host*-side cdc_acm driver, it is a
# different symbol, and it stays: it is what lets the tablet talk to a USB-serial
# adapter (the pogo keyboard's debug link, for instance).
# CONFIG_USB_CONFIGFS_ACM is not set
# CONFIG_USB_CONFIGFS_SERIAL is not set
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_NXP_PTN3222=y
CONFIG_PHY_QCOM_QMP_COMBO=y

# --- Serial debug consoles: removed 2026-09-26 -----------------------------
#
# The debug role of both UARTs is retired, and removing it at the source is what
# takes the console stalls out of boot and shutdown.  The measurements behind
# each half are in docs/BOOT_CONSOLE_BLOCK.md and docs/SHUTDOWN_DELAY.md; the
# two mechanisms differ and both are closed here rather than worked around in
# userspace.
#
# 1. The USB gadget console (ttyGS1, host COM19).
#    `console=ttyGS1` makes the kernel give /dev/console to the *last*
#    successfully registering console, and n_tty_write() to a gadget serial
#    port waits on tty->write_wait until that port has room.  Nothing drains
#    COM19 on an unattended boot, so any userspace write() to /dev/console
#    blocks indefinitely - measured: 60 KB took the full timeout and completed
#    the instant COM19 was opened.  printk is lossy by design (8 KiB kfifo,
#    overflow counted and discarded) and measured 0.048 s for 5000 lines with
#    COM19 closed, so the blocking writer is always a userspace write(), never
#    printk.
#    CONFIG_U_SERIAL_CONSOLE is the switch that lets gserial_alloc_line() call
#    gs_console_init() for the first ACM port at all.  With it unset the
#    configfs `console` attribute does not exist, no ttyGS port can become a
#    kernel console, and printk cannot be attached to the gadget - which
#    removes the failure mode instead of relying on userspace never writing to
#    /dev/console.
#
# 2. The SoC UART (ttyMSM0).
#    Nothing is wired to it on this tablet and the debug link is the USB
#    network (ssh at 31.8 MB/s, docs/FAST_DEBUG_CHANNEL.md).  It has no
#    userspace writer and so does not stall a boot on its own; it is removed
#    because it is the second of the two serial debug consoles, and because
#    every `console=` argument also costs a systemd-getty-generator unit and a
#    dev-ttyMSM0.device dependency that had to be masked by hand.
#    CONFIG_SERIAL_QCOM_GENI itself stays =y: the GENI SE block is shared IP and
#    the port is still registered, only its *console* is gone.  `earlycon` is
#    dropped from the command line with it - see boot/cmdline.example.txt.
# CONFIG_U_SERIAL_CONSOLE is not set
# CONFIG_SERIAL_QCOM_GENI_CONSOLE is not set

# With both of those gone the command line carries a single real console,
# `console=tty0` on the panel.  Samsung's ABL appends `console=null` after our
# own arguments; without CONFIG_NULL_TTY that request compiles to
# __add_preferred_console("ttynull", ...) which no driver ever satisfies, so it
# stays unresolved even though it is still the last entry in console_cmdline.
# Keeping NULL_TTY registered makes the appended argument resolve to a real,
# non-blocking tty that discards what it is given - ttynull_write() returns
# count without waiting for anything - so the panel console keeps working and
# /dev/console can never be a port that blocks.
#
# The alternative carried until 2026-09-26 was kernel patch 0003
# (`ignore_console_null`), which deleted the appended argument outright.  That
# patch retires with the gadget console it existed to protect: with no ttyMSM0
# and no ttyGS console on the command line there is nothing left for
# `console=null` to displace, so the patch is dropped from the queue and core
# printk goes back to unmodified upstream.  NULL_TTY is upstream and small.
CONFIG_NULL_TTY=y

# Input/I2C foundations. The stock X710 uses STM FTS1BA90A + Wacom WEZ01;
# their device-specific drivers are intentionally not invented here.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y
# Populate the PON child nodes for qcom,pmk8350-pwrkey so the PMIC power key
# is registered as an input device and its default wake source can arm
# the PON IRQ.
CONFIG_POWER_RESET_QCOM_PON=y

# PCIe/radio foundations. X710 stock evidence identifies QCA6490/WCN6855-class
# hardware; ath11k is upstream and can be modular while early boot stays small.
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_MHI_BUS=y
CONFIG_WLAN=y
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH_COMMON=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m

# Bluetooth QCA transport. Modular is preferable once firmware is supplied by
# the real rootfs rather than relying on an early initramfs copy.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m

# Remoteproc/RPMSG foundations for later ADSP/audio/sensor work.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_FASTRPC=y

# Bring-up kernel: Rust is unnecessary and increases toolchain requirements.
# CONFIG_RUST is not set

# ---------------------------------------------------------------------------
# Bring-up deltas over the immutable 5.15.153 stock seed.
#
# The seed stays byte-for-byte evidence; everything here is an explicit,
# reviewable override. Sections 1 and 2 exist because olddefconfig silently
# dropped symbols requested above (AGENT.md rule 7): the drivers were not
# even visible because their parent menuconfigs are absent from a 5.15
# Android tree.
# ---------------------------------------------------------------------------

# 1. Kconfig parents/selects for drivers requested above. Without these,
#    olddefconfig hides the driver symbol entirely:
#      PINCTRL_MSM      -> PINCTRL_SM8550 (TLMM: every GPIO in the board DTS)
#      PHY_QCOM_QMP     -> PHY_QCOM_QMP_UFS / _PCIE / _COMBO (menuconfig)
#      MFD_SPMI_PMIC    -> INPUT_PM8941_PWRKEY, RTC_DRV_PM8XXX
#      WLAN_VENDOR_ATH  -> ATH_COMMON / ATH11K / ATH11K_PCI
CONFIG_PINCTRL_MSM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_WLAN_VENDOR_ATH=y

# 2. SM8550 platform plumbing that the board DTS depends on but that the
#    stock 5.15 Android config leaves out. UFS, PCIe, USB, the PMICs and the
#    display/GPU power rails all fail to probe without these.
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_QCOM_CLK_RPMH=y
# The SM8550 TCSR clock controller gates the USB reference clocks:
# usb@a600000 needs <&tcsr TCSR_USB3_CLKREF_EN> and the eUSB2 PHY needs its
# TCSR ref clock. Without this driver both defer forever (-517), dwc3 never
# binds, and there is no UDC for the bring-up USB gadget. Evidence: the
# owner-supplied July kmsg (reference/boot-tests/owner-supplied-july-kernel/)
# shows a600000.usb and 88e3000.phy stuck on 1fc0000.clock-controller.
CONFIG_SM_TCSRCC_8550=y
CONFIG_QCOM_RPMHPD=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_WDT=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_QCOM_TSENS=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_ADC5=y
# The PDC is the interrupt controller the SPMI arbiter hangs off
# (spmi@c400000 interrupts-extended = <&pdc 1 ...>), and usb@a600000 takes its
# dp/dm/ss phy interrupts from it as well. The stock 5.15 seed leaves the driver
# out, so in mainline the arbiter never gets its IRQ, defers forever, and the
# entire PMIC side of the board disappears with it: the microSD card-detect GPIO
# is pm8550 GPIO 12, and the PMK8550 RTC, ADC and haptics are all SPMI devices.
# That is the failure shape seen in tests 012-019 - no /dev/mmcblk*, no
# /dev/rtc0 (the RTC state word of test 018 was never written), and no gadget.
CONFIG_QCOM_PDC=y
# The AMSA10FA01 panel: mainline has mdss, the DPU, the DSI host and the 4nm DSI
# PHY for SM8550, but no driver for this panel, so the display stays dark and
# the kernel console has nowhere to go.  The driver is an overlay file
# (kernel/drivers/panel-samsung-ana38407.c) wired in by
# kernel/patches/0004-drm-panel-add-samsung-ana38407.patch.
CONFIG_DRM_PANEL_SAMSUNG_ANA38407=y
# Rebooting into a named bootloader mode. The board DT already declares
# reboot-mode (nvmem-reboot-mode, mode-recovery = 0x01) on the PMK8550's SDAM,
# but neither the SDAM nvmem provider nor the driver were built, so /init could
# only power the tablet off after a test. With these, a RESTART2 reboot with the
# string "recovery" leaves 0x01 in the SDAM cell that Samsung's ABL reads, which
# is the difference between a dead tablet and one that comes back in TWRP.
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y

# 3. Usable console. Samsung's Android kernel runs without virtual terminals,
#    so fbcon never binds the DRM/fbdev emulated console. Enabling VT is what
#    makes the FRAMEBUFFER_CONSOLE request in the display section above
#    reachable at all (drivers/video/console/Kconfig is sourced `if VT`).
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# 4. Toolchain/debug profile for a flashable bring-up kernel. The stock seed
#    is an Android debug configuration: Clang full LTO + kCFI + KASAN + UBSAN
#    + -Werror. Full LTO turns the final link into a single-threaded,
#    multi-hour, high-memory step, and kCFI/KASAN change the runtime
#    behaviour of every early probe. Re-enable them per subsystem once the
#    port is stable; the seed keeps the stock intent on record.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_CFI is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_WERROR is not set

# 5. Do not inject Samsung's downstream debug cmdline
#    ("stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected
#    cgroup_disable=pressure") into a kernel that no longer enables KASAN.
CONFIG_CMDLINE=""

# 6. Stable module path: keep the git-describe suffix out of the release
#    string so the module directory does not drift with worktree state.
#    (setlocalversion still appends "-dirty" while the device overlay is
#    uncommitted, which is accurate for these artifacts.)
CONFIG_LOCALVERSION="-gts9wifi"
# CONFIG_LOCALVERSION_AUTO is not set

# Official EF-DX710 STM32 pogo keyboard, native input port.
CONFIG_INPUT_KEYBOARD=y
# The tested X710 path uses the mainline port below. The imported Samsung
# stm32_pogo_v3 under kernel/drivers/input/samsung-pogo/ is reference-only and
# is not installed by the default prepare-kernel.sh path.
CONFIG_KEYBOARD_SAMSUNG_POGO=y
# CONFIG_KEYBOARD_SAMSUNG_POGO_VENDOR_PORT is not set

# Console font: the 8x16 default is unreadable on a 2560x1600 panel.
# FONTS is selected by FRAMEBUFFER_CONSOLE, but assert it explicitly so the
# Terminus font is not dropped by olddefconfig (it depends on FONTS).
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
