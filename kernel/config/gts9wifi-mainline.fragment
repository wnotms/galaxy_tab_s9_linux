# Samsung Galaxy Tab S9 Wi-Fi (SM-X710 / gts9wifi) early mainline fragment.
# Keep this file limited to upstream Kconfig symbols. Out-of-tree subsystem
# drivers are added later with the patch/driver that defines their symbol.

# Early boot and diagnostics.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_PRINTK_TIME=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# Primary persistent log channel for the first boot test: the kernel console is
# written into Samsung's sec_log_buf ring, which TWRP/recovery exposes as
# /proc/last_kmsg after a warm reset.  Built in, because it must exist before
# any root filesystem is available (driver: kernel/drivers/, patch 0002).
CONFIG_SAMSUNG_GTS9WIFI_SEC_LOG=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PM_DEBUG=y
# Preserve a panic for inspection instead of inheriting stock's immediate
# reboot (PANIC_TIMEOUT=-1). Firmware watchdog resets are independent of this.
CONFIG_PANIC_TIMEOUT=0
# The boot bundle uses legacy LZ4 for both ramdisks.
CONFIG_RD_LZ4=y

# Root storage: both internal UFS and microSD must work without modules.
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_EFI_PARTITION=y

# SM8550 platform plumbing used by several early providers.
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_LLCC=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SM8550=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_SM_GCC_8550=y
CONFIG_SM_GPUCC_8550=y
CONFIG_SM_DISPCC_8550=y
CONFIG_PINCTRL_SM8550=y
# Was PINCTRL_SPMI_PMIC in 5.15; renamed upstream and still required for the
# PM8550/PMK8550 GPIO and MPP blocks used by the board DTS.
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_QCOM_RPMH=y

# Display/GPU. The board DTS may still require device-specific panel work, but
# the upstream MSM/DPU/Adreno side should be built into early test kernels.
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# USB rescue path and Type-C core.
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_PHY_NXP_PTN3222=y
CONFIG_PHY_QCOM_QMP_COMBO=y

# Input/I2C foundations. The stock X710 uses STM FTS1BA90A + Wacom WEZ01;
# their device-specific drivers are intentionally not invented here.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_PM8941_PWRKEY=y

# PCIe/radio foundations. X710 stock evidence identifies QCA6490/WCN6855-class
# hardware; ath11k is upstream and can be modular while early boot stays small.
CONFIG_PCI=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_MHI_BUS=y
CONFIG_WLAN=y
CONFIG_RFKILL=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_ATH_COMMON=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m

# Bluetooth QCA transport. Modular is preferable once firmware is supplied by
# the real rootfs rather than relying on an early initramfs copy.
CONFIG_BT=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_QCA=m

# Remoteproc/RPMSG foundations for later ADSP/audio/sensor work.
CONFIG_REMOTEPROC=y
CONFIG_QCOM_RPROC_COMMON=y
CONFIG_QCOM_Q6V5_COMMON=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_FASTRPC=y

# Bring-up kernel: Rust is unnecessary and increases toolchain requirements.
# CONFIG_RUST is not set

# ---------------------------------------------------------------------------
# Bring-up deltas over the immutable 5.15.153 stock seed.
#
# The seed stays byte-for-byte evidence; everything here is an explicit,
# reviewable override. Sections 1 and 2 exist because olddefconfig silently
# dropped symbols requested above (AGENT.md rule 7): the drivers were not
# even visible because their parent menuconfigs are absent from a 5.15
# Android tree.
# ---------------------------------------------------------------------------

# 1. Kconfig parents/selects for drivers requested above. Without these,
#    olddefconfig hides the driver symbol entirely:
#      PINCTRL_MSM      -> PINCTRL_SM8550 (TLMM: every GPIO in the board DTS)
#      PHY_QCOM_QMP     -> PHY_QCOM_QMP_UFS / _PCIE / _COMBO (menuconfig)
#      MFD_SPMI_PMIC    -> INPUT_PM8941_PWRKEY, RTC_DRV_PM8XXX
#      WLAN_VENDOR_ATH  -> ATH_COMMON / ATH11K / ATH11K_PCI
CONFIG_PINCTRL_MSM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_USB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_WLAN_VENDOR_ATH=y

# 2. SM8550 platform plumbing that the board DTS depends on but that the
#    stock 5.15 Android config leaves out. UFS, PCIe, USB, the PMICs and the
#    display/GPU power rails all fail to probe without these.
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_QCOM_CLK_RPMH=y
# The SM8550 TCSR clock controller gates the USB reference clocks:
# usb@a600000 needs <&tcsr TCSR_USB3_CLKREF_EN> and the eUSB2 PHY needs its
# TCSR ref clock. Without this driver both defer forever (-517), dwc3 never
# binds, and there is no UDC for the bring-up USB gadget. Evidence: the
# owner-supplied July kmsg (reference/boot-tests/owner-supplied-july-kernel/)
# shows a600000.usb and 88e3000.phy stuck on 1fc0000.clock-controller.
CONFIG_SM_TCSRCC_8550=y
CONFIG_QCOM_RPMHPD=y
CONFIG_ARM_SMMU=y
CONFIG_QCOM_WDT=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_QCOM_TSENS=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_ADC5=y
# The PDC is the interrupt controller the SPMI arbiter hangs off
# (spmi@c400000 interrupts-extended = <&pdc 1 ...>), and usb@a600000 takes its
# dp/dm/ss phy interrupts from it as well. The stock 5.15 seed leaves the driver
# out, so in mainline the arbiter never gets its IRQ, defers forever, and the
# entire PMIC side of the board disappears with it: the microSD card-detect GPIO
# is pm8550 GPIO 12, and the PMK8550 RTC, ADC and haptics are all SPMI devices.
# That is the failure shape seen in tests 012-019 - no /dev/mmcblk*, no
# /dev/rtc0 (the RTC state word of test 018 was never written), and no gadget.
CONFIG_QCOM_PDC=y
# The AMSA10FA01 panel: mainline has mdss, the DPU, the DSI host and the 4nm DSI
# PHY for SM8550, but no driver for this panel, so the display stays dark and
# the kernel console has nowhere to go.  The driver is an overlay file
# (kernel/drivers/panel-samsung-ana38407.c) wired in by
# kernel/patches/0004-drm-panel-add-samsung-ana38407.patch.
CONFIG_DRM_PANEL_SAMSUNG_ANA38407=y
# Rebooting into a named bootloader mode. The board DT already declares
# reboot-mode (nvmem-reboot-mode, mode-recovery = 0x01) on the PMK8550's SDAM,
# but neither the SDAM nvmem provider nor the driver were built, so /init could
# only power the tablet off after a test. With these, a RESTART2 reboot with the
# string "recovery" leaves 0x01 in the SDAM cell that Samsung's ABL reads, which
# is the difference between a dead tablet and one that comes back in TWRP.
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y

# 3. Usable console. Samsung's Android kernel runs without virtual terminals,
#    so fbcon never binds the DRM/fbdev emulated console. Enabling VT is what
#    makes the FRAMEBUFFER_CONSOLE request in the display section above
#    reachable at all (drivers/video/console/Kconfig is sourced `if VT`).
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# 4. Toolchain/debug profile for a flashable bring-up kernel. The stock seed
#    is an Android debug configuration: Clang full LTO + kCFI + KASAN + UBSAN
#    + -Werror. Full LTO turns the final link into a single-threaded,
#    multi-hour, high-memory step, and kCFI/KASAN change the runtime
#    behaviour of every early probe. Re-enable them per subsystem once the
#    port is stable; the seed keeps the stock intent on record.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_CFI is not set
# CONFIG_KASAN is not set
# CONFIG_UBSAN is not set
# CONFIG_WERROR is not set

# 5. Do not inject Samsung's downstream debug cmdline
#    ("stack_depot_disable=on kasan.stacktrace=off kvm-arm.mode=protected
#    cgroup_disable=pressure") into a kernel that no longer enables KASAN.
CONFIG_CMDLINE=""

# 6. Stable module path: keep the git-describe suffix out of the release
#    string so the module directory does not drift with worktree state.
#    (setlocalversion still appends "-dirty" while the device overlay is
#    uncommitted, which is accurate for these artifacts.)
CONFIG_LOCALVERSION="-gts9wifi"
# CONFIG_LOCALVERSION_AUTO is not set

# Official EF-DX710 STM32 pogo keyboard, native input port.
CONFIG_INPUT_KEYBOARD=y
# A/B: exactly one pogo driver is built.  The vendor port is the imported
# Samsung stm32_pogo_v3 (kernel/drivers/input/samsung-pogo/); flip these two
# lines to build the mainline port instead.
CONFIG_KEYBOARD_SAMSUNG_POGO=y
# CONFIG_KEYBOARD_SAMSUNG_POGO_VENDOR_PORT is not set

# Console font: the 8x16 default is unreadable on a 2560x1600 panel.
# FONTS is selected by FRAMEBUFFER_CONSOLE, but assert it explicitly so the
# Terminus font is not dropped by olddefconfig (it depends on FONTS).
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
