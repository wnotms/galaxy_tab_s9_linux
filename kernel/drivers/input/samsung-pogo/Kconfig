# A/B choice: exactly one pogo keyboard driver may be built, because both bind
# the same DT node.  CONFIG_KEYBOARD_SAMSUNG_POGO is the port written for this
# bring-up (drivers/input/keyboard/keyboard-samsung-pogo.c);
# CONFIG_KEYBOARD_SAMSUNG_POGO_VENDOR_PORT is Samsung's own stm32_pogo_v3
# imported nearly verbatim.  Comparing the two on identical hardware, kernel,
# DTS, GENI driver and initramfs is what tells whether the fault is in the
# driver's logic or below it.
#
config KEYBOARD_SAMSUNG_POGO_VENDOR_PORT
	tristate "Samsung X710 pogo keyboard (vendor stm32_pogo_v3 port)"
	depends on I2C && OF && GPIOLIB && REGULATOR
	depends on !KEYBOARD_SAMSUNG_POGO
	help
	  Samsung's stm32_pogo_v3 imported from the SM-X710 open source release
	  into drivers/input/keyboard/samsung-pogo/, with only the Android
	  interfaces removed (sec_class sysfs, factory and FOTA interfaces,
	  Samsung framework stubs).  Probe order, regulator and GPIO timing, IRQ
	  timing, workqueues, CHECK_VERSION, GET_MODE and the reconnect flow are
	  kept as they are, so this driver and the mainline port can be compared
	  under otherwise identical conditions.
