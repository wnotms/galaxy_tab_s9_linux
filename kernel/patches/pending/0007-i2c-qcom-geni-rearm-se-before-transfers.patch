From: X710 bring-up <bringup@localhost>
Subject: [PATCH] i2c: qcom-geni: re-arm the serial engine on samsung,reset-before-trans

Samsung's SM-X710 device tree marks the QUP2 SE7 I2C controller that hosts the
EF-DX710 pogo keyboard with samsung,reset-before-trans (and stop-after-trans),
and its downstream geni driver re-arms the serial engine before every transfer
because of it.

Without that, mainline binds the keyboard, drives its rail and pulses its reset,
and the STM32 still never answers: every read returns a clean -ENXIO (a NACK, so
the bus is idle rather than stuck) and a quick-write scan of the whole adapter
finds no device at any address, while TWRP's stock kernel on the same tablet, the
same controller and the same two pins enumerates the cover as
EF-DX710_v1.4.1.0, con:1/1, model_id 0x2 in the same session (test 045).

The data sheet level reason is not documented; the behaviour is.  geni_se_rearm()
replays what geni_load_se_fw() ends with - the default values on GENI's output
pads and the SCLK/HCLK toggle that applies the configuration, plus the FIFO/DMA
interface selection - which is the closest equivalent of the vendor's controller
reset that does not need firmware this platform does not use (SM8550 sets no
firmware-name, and geni_load_se_firmware() fails with -EINVAL there).  The I2C
driver calls it before every transfer when the DT property is present, and
qcom_geni_i2c_conf() re-applies the packing and watermarks immediately after, so
no other board is affected.
---
diff --git a/drivers/i2c/busses/i2c-qcom-geni.c b/drivers/i2c/busses/i2c-qcom-geni.c
index d2f5055b0..97889ff64 100644
--- a/drivers/i2c/busses/i2c-qcom-geni.c
+++ b/drivers/i2c/busses/i2c-qcom-geni.c
@@ -119,6 +119,7 @@ struct geni_i2c_dev {
 	bool gpi_mode;
 	bool abort_done;
 	bool is_tx_multi_desc_xfer;
+	bool reset_before_trans;
 	u32 num_msgs;
 	struct geni_i2c_gpi_multi_desc_xfer i2c_multi_desc_config;
 };
@@ -921,6 +922,16 @@ static int geni_i2c_xfer(struct i2c_adapter *adap,
 		return ret;
 	}
 
+	/*
+	 * Boards that ask for samsung,reset-before-trans want the serial engine
+	 * re-armed before each transfer: the default pad values and the
+	 * SCLK/HCLK toggle that applies the configuration, which is the tail of
+	 * the firmware load probe performs.  qcom_geni_i2c_conf() below then
+	 * re-applies the I2C packing and watermarks.
+	 */
+	if (gi2c->reset_before_trans)
+		geni_se_rearm(&gi2c->se);
+
 	qcom_geni_i2c_conf(gi2c);
 
 	if (gi2c->gpi_mode)
@@ -1055,6 +1066,13 @@ static int geni_i2c_probe(struct platform_device *pdev)
 	gi2c->adap.dev.parent = dev;
 	gi2c->adap.dev.of_node = dev->of_node;
 	strscpy(gi2c->adap.name, "Geni-I2C", sizeof(gi2c->adap.name));
+	/*
+	 * Some boards need the serial engine re-armed before every transfer.
+	 * Samsung's SM-X710 node asks for it with samsung,reset-before-trans,
+	 * and without it the pogo keyboard's STM32 never answers.
+	 */
+	gi2c->reset_before_trans =
+		of_property_read_bool(dev->of_node, "samsung,reset-before-trans");
 
 	ret = geni_icc_get(&gi2c->se, desc ? desc->icc_ddr : "qup-memory");
 	if (ret)
diff --git a/drivers/soc/qcom/qcom-geni-se.c b/drivers/soc/qcom/qcom-geni-se.c
index 15636a8dc..ccd5db8e4 100644
--- a/drivers/soc/qcom/qcom-geni-se.c
+++ b/drivers/soc/qcom/qcom-geni-se.c
@@ -1593,6 +1593,31 @@ int geni_load_se_firmware(struct geni_se *se, enum geni_se_protocol_type protoco
 }
 EXPORT_SYMBOL_GPL(geni_load_se_firmware);
 
+/**
+ * geni_se_rearm() - Re-apply the serial engine's idle configuration.
+ * @se:		Pointer to the concerned serial engine.
+ *
+ * Replays the tail of geni_load_se_fw(): the default values on GENI's output
+ * pads and the SCLK/HCLK toggle that applies the configuration.  Some boards ask
+ * for the serial engine to be re-armed before every transfer
+ * (samsung,reset-before-trans on the SM-X710's pogo keyboard controller, whose
+ * STM32 does not answer otherwise), and this is the closest thing to the
+ * vendor's controller reset that does not require reloading firmware the
+ * platform does not use.
+ */
+void geni_se_rearm(struct geni_se *se)
+{
+	writel_relaxed(0x1, se->base + GENI_FORCE_DEFAULT_REG);
+
+	geni_setbits32(se->base + SE_GENI_CGC_CTRL, PROG_RAM_SCLK_OFF | PROG_RAM_HCLK_OFF);
+	geni_setbits32(se->base + SE_GENI_CLK_CTRL, SER_CLK_SEL);
+	geni_clrbits32(se->base + SE_GENI_CGC_CTRL, PROG_RAM_SCLK_OFF | PROG_RAM_HCLK_OFF);
+
+	geni_setbits32(se->base + SE_DMA_IF_EN, DMA_IF_EN);
+	geni_clrbits32(se->base + SE_FIFO_IF_DISABLE, FIFO_IF_DISABLE);
+}
+EXPORT_SYMBOL_GPL(geni_se_rearm);
+
 static int geni_se_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
diff --git a/include/linux/soc/qcom/geni-se.h b/include/linux/soc/qcom/geni-se.h
index c5e6ab85d..e0828bb3e 100644
--- a/include/linux/soc/qcom/geni-se.h
+++ b/include/linux/soc/qcom/geni-se.h
@@ -549,6 +549,8 @@ int geni_se_resources_deactivate(struct geni_se *se);
 
 int geni_load_se_firmware(struct geni_se *se, enum geni_se_protocol_type protocol);
 
+void geni_se_rearm(struct geni_se *se);
+
 int geni_se_domain_attach(struct geni_se *se);
 
 int geni_se_set_perf_level(struct geni_se *se, unsigned long level);
