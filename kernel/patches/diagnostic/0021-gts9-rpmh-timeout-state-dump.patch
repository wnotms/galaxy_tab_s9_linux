diff --git a/drivers/soc/qcom/rpmh-internal.h b/drivers/soc/qcom/rpmh-internal.h
index e3cf1beff..b82c6c9e8 100644
--- a/drivers/soc/qcom/rpmh-internal.h
+++ b/drivers/soc/qcom/rpmh-internal.h
@@ -145,4 +145,17 @@ void rpmh_rsc_write_next_wakeup(struct rsc_drv *drv);
 void rpmh_tx_done(const struct tcs_request *msg);
 int rpmh_flush(struct rpmh_ctrlr *ctrlr);
 
+/*
+ * gts9 RPMh timeout diagnostic (opt-in, default off).
+ *
+ * Compiled in only when kernel/patches/diagnostic/0021-* is applied, and inert
+ * unless the command line carries gts9_rpmh_debug=1.  The normal path costs one
+ * predictable branch; state is captured only when an ACTIVE_ONLY transfer
+ * actually times out.
+ */
+bool gts9_rpmh_debug_enabled(void);
+void gts9_rpmh_note_tx_done(const struct tcs_request *msg);
+void gts9_rpmh_dump_timeout(const struct rsc_drv *drv,
+			    const struct tcs_request *msg);
+
 #endif /* __RPM_INTERNAL_H__ */
diff --git a/drivers/soc/qcom/rpmh-rsc.c b/drivers/soc/qcom/rpmh-rsc.c
index c6f7d5c9c..c9004a345 100644
--- a/drivers/soc/qcom/rpmh-rsc.c
+++ b/drivers/soc/qcom/rpmh-rsc.c
@@ -489,6 +489,209 @@ static irqreturn_t tcs_tx_done(int irq, void *p)
  *
  * This is used for all types of transfers (active, sleep, and wake).
  */
+/*
+ * ---------------------------------------------------------------------------
+ * gts9 RPMh timeout diagnostic
+ *
+ * Opt-in with gts9_rpmh_debug=1 on the command line; inert otherwise (one
+ * static-key-free predictable branch on the send and completion paths).
+ *
+ * It answers the question a plain "RPMh transaction timed out" warning cannot:
+ * where in
+ *	client -> rpmh_write_batch -> rpmh_rsc_send_data -> TCS claim ->
+ *	TCS program -> trigger -> RSC -> IRQ -> tcs_tx_done -> rpmh_tx_done ->
+ *	completion
+ * the transfer actually stopped.  On timeout it dumps the RSC/TCS registers,
+ * the in-use bitmap, the request still stashed in tcs->req[], and a bounded
+ * in-memory ring of the last send/completion events - so "was there a send
+ * without a matching completion?" is answered from data, not from inference.
+ *
+ * Deliberately no continuous tracing and no per-event I/O: 128 events of 20
+ * bytes live in RAM, and only a real timeout prints anything.
+ * ---------------------------------------------------------------------------
+ */
+#define GTS9_RPMH_EV_RING	128
+#define GTS9_RPMH_LATE_MAX	8
+
+struct gts9_rpmh_ev {
+	u32 ms;		/* ktime_get() in ms; all fields <= 32 bit on purpose */
+	u32 addr;
+	u32 data;
+	u16 tcs_id;
+	u8 state;
+	u8 kind;	/* 0 = send, 1 = completion */
+	u8 cmd_idx;
+};
+
+static struct gts9_rpmh_ev gts9_rpmh_ev[GTS9_RPMH_EV_RING];
+static atomic_t gts9_rpmh_ev_seq = ATOMIC_INIT(0);
+static const struct tcs_request *gts9_rpmh_late[GTS9_RPMH_LATE_MAX];
+static atomic_t gts9_rpmh_late_seq = ATOMIC_INIT(0);
+static bool gts9_rpmh_debug;
+
+static int __init gts9_rpmh_debug_setup(char *str)
+{
+	gts9_rpmh_debug = !strcmp(str, "1");
+	return 0;
+}
+early_param("gts9_rpmh_debug", gts9_rpmh_debug_setup);
+
+bool gts9_rpmh_debug_enabled(void)
+{
+	return gts9_rpmh_debug;
+}
+
+static void gts9_rpmh_ev_add(u8 kind, const struct tcs_request *msg,
+			     int tcs_id, int cmd_idx)
+{
+	struct gts9_rpmh_ev ev = { 0 };
+	int slot;
+
+	ev.ms = div_u64(ktime_get(), NSEC_PER_MSEC);
+	ev.tcs_id = tcs_id;
+	ev.state = msg ? msg->state : 0xff;
+	ev.kind = kind;
+	ev.cmd_idx = cmd_idx;
+	if (msg && cmd_idx >= 0 && cmd_idx < msg->num_cmds) {
+		ev.addr = msg->cmds[cmd_idx].addr;
+		ev.data = msg->cmds[cmd_idx].data;
+	}
+	/* Plain assignment: READ_ONCE()/WRITE_ONCE() only take word-sized
+	 * objects, and a torn diagnostic record is acceptable - the ring is
+	 * only ever read after the fact, and every field is independent.
+	 */
+	slot = atomic_inc_return(&gts9_rpmh_ev_seq) - 1;
+	gts9_rpmh_ev[slot % GTS9_RPMH_EV_RING] = ev;
+}
+
+void gts9_rpmh_note_tx_done(const struct tcs_request *msg)
+{
+	int i;
+
+	/* Remember requests that already timed out, so a late completion for the
+	 * same request is reported instead of being silently consumed.
+	 */
+	for (i = 0; i < GTS9_RPMH_LATE_MAX; i++) {
+		if (READ_ONCE(gts9_rpmh_late[i]) == msg) {
+			pr_err("gts9-rpmh: LATE COMPLETION for a request that already timed out (msg=%px) - the rpmh_write_batch() lifetime hazard is real\n",
+			       msg);
+			WRITE_ONCE(gts9_rpmh_late[i], NULL);
+			break;
+		}
+	}
+	gts9_rpmh_ev_add(1, msg, -1, 0);
+}
+
+static void gts9_rpmh_dump_tcs(const struct rsc_drv *drv, int tcs_id)
+{
+	u32 enable, msgid, addr, data;
+	int j;
+
+	enable = read_tcs_reg(drv, drv->regs[RSC_DRV_CMD_ENABLE], tcs_id);
+	pr_err("gts9-rpmh:   tcs[%d] cmd_enable=0x%08x wait_for_cmpl=0x%08x\n",
+	       tcs_id, enable,
+	       read_tcs_reg(drv, drv->regs[RSC_DRV_CMD_WAIT_FOR_CMPL], tcs_id));
+	for (j = 0; j < MAX_RPMH_PAYLOAD; j++) {
+		if (!(enable & BIT(j)))
+			continue;
+		msgid = read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_MSGID], tcs_id, j);
+		addr = read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_ADDR], tcs_id, j);
+		data = read_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_DATA], tcs_id, j);
+		pr_err("gts9-rpmh:     cmd[%d] msgid=0x%08x addr=0x%08x data=0x%08x\n",
+		       j, msgid, addr, data);
+	}
+}
+
+void gts9_rpmh_dump_timeout(const struct rsc_drv *drv,
+			    const struct tcs_request *msg)
+{
+	unsigned long irq_status;
+	int i, j, seq, start;
+	int send = 0, done = 0, matched_send = 0, matched_done = 0;
+	int holder = -1, holder_group = -1;
+
+	if (!drv || !msg)
+		return;
+
+	pr_err("gts9-rpmh: TIMEOUT rsc=%s state=%u cmds=%u cpu=%d comm=%s pid=%d\n",
+	       drv->name, msg->state, msg->num_cmds, raw_smp_processor_id(),
+	       current->comm, current->pid);
+	for (i = 0; i < msg->num_cmds; i++)
+		pr_err("gts9-rpmh:   cmd[%d] addr=0x%08x data=0x%08x wait=%u\n",
+		       i, msg->cmds[i].addr, msg->cmds[i].data,
+		       msg->cmds[i].wait);
+
+	pr_err("gts9-rpmh: tcs_in_use=0x%08lx num_tcs=%d\n",
+	       drv->tcs_in_use[0], drv->num_tcs);
+	irq_status = readl_relaxed(drv->tcs_base + drv->regs[RSC_DRV_IRQ_STATUS]);
+	pr_err("gts9-rpmh: irq_status=0x%08lx irq_enable=0x%08x\n", irq_status,
+	       readl_relaxed(drv->tcs_base + drv->regs[RSC_DRV_IRQ_ENABLE]));
+	/* CMD_STATUS/CMD_RESP_DATA are deliberately not read: no mainline code
+	 * path reads them, and poking an unproven register on a controller that
+	 * has stopped answering is not something a diagnostic should risk.
+	 */
+	for (i = 0; i < TCS_TYPE_NR; i++)
+		pr_err("gts9-rpmh: group[%d] mask=0x%08x offset=%d num_tcs=%d req[0]=%px\n",
+		       i, drv->tcs[i].mask, drv->tcs[i].offset,
+		       drv->tcs[i].num_tcs, drv->tcs[i].req[0]);
+
+	for_each_set_bit(i, drv->tcs_in_use, MAX_TCS_NR) {
+		const struct tcs_request *stashed = get_req_from_tcs((struct rsc_drv *)drv, i);
+
+		if (stashed == msg) {
+			holder = i;
+			holder_group = -1;
+			for (j = 0; j < TCS_TYPE_NR; j++) {
+				if (drv->tcs[j].mask & BIT(i))
+					holder_group = j;
+			}
+		}
+		pr_err("gts9-rpmh: in_use tcs=%d irq_bit=%d req=%px%s\n", i,
+		       !!(irq_status & BIT(i)), stashed,
+		       stashed == msg ? "  <-- the timed-out request" : "");
+		gts9_rpmh_dump_tcs(drv, i);
+	}
+	pr_err("gts9-rpmh: holder_tcs=%d group=%d (%s)\n", holder, holder_group,
+	       holder < 0 ? "request not stashed in any TCS: it never reached programming, or it was already reclaimed"
+			  : "request is still stashed in a TCS");
+
+	/* Ring: last 32 events, plus a match count against this request. */
+	seq = atomic_read(&gts9_rpmh_ev_seq);
+	start = seq > 32 ? seq - 32 : 0;
+	pr_err("gts9-rpmh: ring last %d of %d events\n", seq - start, seq);
+	for (i = start; i < seq; i++) {
+		struct gts9_rpmh_ev ev = gts9_rpmh_ev[i % GTS9_RPMH_EV_RING];
+		bool match = false;
+
+		if (ev.kind == 0)
+			send++;
+		else
+			done++;
+		for (j = 0; j < msg->num_cmds; j++) {
+			if (ev.addr == msg->cmds[j].addr &&
+			    ev.data == msg->cmds[j].data)
+				match = true;
+		}
+		if (match && ev.kind == 0)
+			matched_send++;
+		if (match && ev.kind == 1)
+			matched_done++;
+		pr_err("gts9-rpmh:   +%ums kind=%s tcs=%d cmd=%d state=%u addr=0x%08x data=0x%08x%s\n",
+		       ev.ms, ev.kind ? "done" : "send", ev.tcs_id, ev.cmd_idx,
+		       ev.state, ev.addr, ev.data, match ? "  <-- matches" : "");
+	}
+	pr_err("gts9-rpmh: ring_summary send=%d done=%d matched_send=%d matched_done=%d => %s\n",
+	       send, done, matched_send, matched_done,
+	       matched_send && !matched_done
+		 ? "this request was programmed but never completed: look at RSC/TCS/IRQ"
+		 : (matched_send ? "completion was seen: look at completion/lifetime handling"
+				 : "no matching send in the ring: it did not reach TCS programming"));
+
+	/* Remember it: a completion after this point is the lifetime hazard. */
+	i = atomic_inc_return(&gts9_rpmh_late_seq) - 1;
+	WRITE_ONCE(gts9_rpmh_late[i % GTS9_RPMH_LATE_MAX], msg);
+}
+
 static void __tcs_buffer_write(struct rsc_drv *drv, int tcs_id, int cmd_id,
 			       const struct tcs_request *msg)
 {
@@ -515,6 +718,8 @@ static void __tcs_buffer_write(struct rsc_drv *drv, int tcs_id, int cmd_id,
 		write_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_ADDR], tcs_id, j, cmd->addr);
 		write_tcs_cmd(drv, drv->regs[RSC_DRV_CMD_DATA], tcs_id, j, cmd->data);
 		trace_rpmh_send_msg(drv, tcs_id, msg->state, j, msgid, cmd);
+		if (unlikely(gts9_rpmh_debug))
+			gts9_rpmh_ev_add(0, msg, tcs_id, i);
 	}
 
 	cmd_enable |= read_tcs_reg(drv, drv->regs[RSC_DRV_CMD_ENABLE], tcs_id);
diff --git a/drivers/soc/qcom/rpmh.c b/drivers/soc/qcom/rpmh.c
index ca37da3dc..4db47319e 100644
--- a/drivers/soc/qcom/rpmh.c
+++ b/drivers/soc/qcom/rpmh.c
@@ -83,6 +83,13 @@ void rpmh_tx_done(const struct tcs_request *msg)
 	struct completion *compl = rpm_msg->completion;
 	bool free = rpm_msg->needs_free;
 
+	/* gts9 diagnostic: record the completion, and complain loudly if this
+	 * request is one that already timed out (see the comment in
+	 * rpmh_write_batch() about a late completion firing into freed memory).
+	 */
+	if (unlikely(gts9_rpmh_debug_enabled()))
+		gts9_rpmh_note_tx_done(msg);
+
 	if (!compl)
 		goto exit;
 
@@ -384,6 +391,19 @@ int rpmh_write_batch(const struct device *dev, enum rpmh_state state,
 			 * we've returned from this function.
 			 */
 			WARN_ON(1);
+			/*
+			 * gts9: capture RSC/TCS state before the request is
+			 * freed.  Diagnostic only, no behaviour change; the
+			 * completion/lifetime hazard the comment above warns
+			 * about is exactly what this dump is meant to expose.
+			 */
+			if (gts9_rpmh_debug_enabled()) {
+				pr_err("gts9-rpmh: dev=%s state=%u batch_index=%d/%d\n",
+				       dev ? dev_name(dev) : "none", state,
+				       i + 1, count);
+				gts9_rpmh_dump_timeout(ctrlr_to_drv(ctrlr),
+						       &rpm_msgs[i].msg);
+			}
 			ret = -ETIMEDOUT;
 			goto exit;
 		}
