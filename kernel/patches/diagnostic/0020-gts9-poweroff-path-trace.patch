diff --git a/drivers/firmware/psci/psci.c b/drivers/firmware/psci/psci.c
index e73bae6cb..a9647437e 100644
--- a/drivers/firmware/psci/psci.c
+++ b/drivers/firmware/psci/psci.c
@@ -331,7 +331,15 @@ static struct notifier_block psci_sys_reset_nb = {
 
 static void psci_sys_poweroff(void)
 {
-	invoke_psci_fn(PSCI_0_2_FN_SYSTEM_OFF, 0, 0, 0);
+	unsigned long ret;
+
+	if (gts9_poweroff_trace_enabled()) {
+		pr_emerg("GTS9_POWER_OFF: PSCI SYSTEM_OFF call\n");
+		pr_flush(1000, true);
+	}
+	ret = invoke_psci_fn(PSCI_0_2_FN_SYSTEM_OFF, 0, 0, 0);
+	if (gts9_poweroff_trace_enabled())
+		pr_emerg("GTS9_POWER_OFF: PSCI SYSTEM_OFF returned 0x%lx\n", ret);
 }
 
