From: gts9wifi mainline port <gts9-mainline@localhost>
Subject: [PATCH] power: sequencing: qcom-wcn: send the AOP WLAN PDC votes, and
 cold-reset WLAN_EN for the X710

On the SM-X710 (gts9wifi) the WCN6855 never appears on PCIe: the controller
reports "Device not found" with the LTSSM sitting in DETECT_QUIET, so no link
partner is ever seen. The board DTS already carries the AOP PDC programming the
vendor's cnss2 performs --

	qcom,qmp = <&aoss_qmp>;
	qcom,wlan-pdc-init = "{class: wlan_pdc, ...}", ...;

-- but no mainline driver reads either property, so on this port the votes are
never sent. The chip's PMU therefore never completes its power handshake and its
PCIe receivers stay undetected.

Two changes, both scoped to the WCN6855 and WCN7850 data:

1. program the AOP WLAN PDC resources through the QMP mailbox at probe, gated on
   the qcom,qmp property so boards without it are unaffected;

2. request wlan-enable with GPIOD_OUT_LOW on these parts and settle briefly
   before the regulator -> clock -> WLAN_EN sequence runs. Upstream deliberately
   uses GPIOD_ASIS to avoid toggling the link, which assumes the boot chain hands
   the chip over already powered; on this board it does not, so the sequence has
   to start from a known state.

Provenance: adapted to this tree from
kernel/patches/wcn7850-pwrseq-cold-reset-aop.patch in the gts9wifi-fedora-linux
port for this same device (commit ab123e7), which carries the same wcn6855-pmu
node and the same 11 PDC strings. That patch is downstream, not upstream; the
on-device verification of this change is recorded separately under
reference/boot-tests/. The generic WLAN PDC helper is not Samsung-specific and
belongs upstream once measured.

Not verified on hardware at the time of writing.

---
diff --git a/drivers/power/sequencing/pwrseq-qcom-wcn.c b/drivers/power/sequencing/pwrseq-qcom-wcn.c
index d41793e1f..fae0df93d 100644
--- a/drivers/power/sequencing/pwrseq-qcom-wcn.c
+++ b/drivers/power/sequencing/pwrseq-qcom-wcn.c
@@ -14,6 +14,7 @@
 #include <linux/property.h>
 #include <linux/regulator/consumer.h>
 #include <linux/pwrseq/provider.h>
+#include <linux/soc/qcom/qcom_aoss.h>
 #include <linux/string.h>
 #include <linux/types.h>
 
@@ -24,6 +25,7 @@ struct pwrseq_qcom_wcn_pdata {
 	unsigned int gpio_enable_delay_ms;
 	const struct pwrseq_target_data **targets;
 	bool has_vddio; /* separate VDD IO regulator */
+	bool cold_reset_wlan;
 	int (*match)(struct pwrseq_device *pwrseq, struct device *dev);
 };
 
@@ -382,6 +384,7 @@ static const struct pwrseq_qcom_wcn_pdata pwrseq_wcn6855_of_data = {
 	.pwup_delay_ms = 50,
 	.gpio_enable_delay_ms = 5,
 	.targets = pwrseq_qcom_wcn6855_targets,
+	.cold_reset_wlan = true,
 };
 
 static const char *const pwrseq_wcn7850_vregs[] = {
@@ -399,6 +402,7 @@ static const struct pwrseq_qcom_wcn_pdata pwrseq_wcn7850_of_data = {
 	.num_vregs = ARRAY_SIZE(pwrseq_wcn7850_vregs),
 	.pwup_delay_ms = 50,
 	.targets = pwrseq_qcom_wcn_targets,
+	.cold_reset_wlan = true,
 };
 
 static int pwrseq_qcom_wcn_match_regulator(struct pwrseq_device *pwrseq,
@@ -454,6 +458,37 @@ static int pwrseq_qcom_wcn3990_match(struct pwrseq_device *pwrseq,
 	return pwrseq_qcom_wcn_match_regulator(pwrseq, dev, "vdd-1.8-xo-supply");
 }
 
+/*
+ * Samsung's cnss2 programs the AOP WLAN PDC resources through the QMP mailbox
+ * before the first WCN power-on.  The X910 FDT carries a qcom,pdc_init_table
+ * for device 0x1107 that enables the baseband PDC resource and the RF rail
+ * votes; without them the WCN PMU never completes its power handshake and
+ * the PCIe receivers stay undetected.  Boards opt in with a qcom,qmp phandle
+ * plus qcom,wlan-pdc-init strings; everything else is skipped silently.
+ */
+static int pwrseq_qcom_wcn_program_wlan_pdc(struct device *dev)
+{
+	struct property *prop;
+	struct qmp *qmp;
+	const char *msg;
+
+	if (!of_property_present(dev->of_node, "qcom,qmp"))
+		return 0;
+
+	qmp = qmp_get(dev);
+	if (IS_ERR(qmp))
+		return dev_err_probe(dev, PTR_ERR(qmp),
+				     "Failed to get the AOP QMP mailbox\n");
+
+	of_property_for_each_string(dev->of_node, "qcom,wlan-pdc-init",
+				    prop, msg)
+		qmp_send(qmp, "%s", msg);
+
+	qmp_put(qmp);
+
+	return 0;
+}
+
 static int pwrseq_qcom_wcn_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -504,7 +539,8 @@ static int pwrseq_qcom_wcn_probe(struct platform_device *pdev)
 	 * the link down handling is implemented in the controller driver.
 	 */
 	ctx->wlan_gpio = devm_gpiod_get_optional(dev, "wlan-enable",
-						 GPIOD_ASIS);
+						 ctx->pdata->cold_reset_wlan ?
+						 GPIOD_OUT_LOW : GPIOD_ASIS);
 	if (IS_ERR(ctx->wlan_gpio))
 		return dev_err_probe(dev, PTR_ERR(ctx->wlan_gpio),
 				     "Failed to get the WLAN enable GPIO\n");
@@ -519,14 +555,27 @@ static int pwrseq_qcom_wcn_probe(struct platform_device *pdev)
 	 * Set direction to output but keep the current value in order to not
 	 * disable the WLAN module accidentally if it's already powered on.
 	 */
-	gpiod_direction_output(ctx->wlan_gpio,
-			       gpiod_get_value_cansleep(ctx->wlan_gpio));
+	/*
+	 * Samsung's WCN sleep state drives WLAN_EN low, but ABL/recovery can
+	 * hand Linux an already-high pin while the PMU rails are unsequenced.  For
+	 * this part the GPIO was requested as OUT_LOW above; settle briefly so the
+	 * normal regulator -> clock -> WLAN_EN sequence starts from a known state.
+	 */
+	if (ctx->pdata->cold_reset_wlan)
+		usleep_range(5000, 10000);
+	else
+		gpiod_direction_output(ctx->wlan_gpio,
+				       gpiod_get_value_cansleep(ctx->wlan_gpio));
 
 	ctx->clk = devm_clk_get_optional(dev, NULL);
 	if (IS_ERR(ctx->clk))
 		return dev_err_probe(dev, PTR_ERR(ctx->clk),
 				     "Failed to get the reference clock\n");
 
+	ret = pwrseq_qcom_wcn_program_wlan_pdc(dev);
+	if (ret)
+		return ret;
+
 	memset(&config, 0, sizeof(config));
 
 	config.parent = dev;
