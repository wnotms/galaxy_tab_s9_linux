From: X710 mainline port <bringup@localhost>
Subject: [PATCH] power: supply: isolate OFF continuous raw ADC observation

Record raw registers without requiring READY. This does not certify converter
freshness, publish a charging supplier or permit pump/PPS activation.

--- a/drivers/power/supply/Kconfig
+++ b/drivers/power/supply/Kconfig
@@ -1220 +1220,11 @@
+config SM5440_ADC_RAW_TEST
+	bool "X710 OFF continuous raw SM5440 ADC observation"
+	depends on CHARGER_SM5440_DIRECT=y && !X710_CHARGING_POLICY
+	depends on TYPEC_SM5714=y && BATTERY_SM5714=y
+	depends on !SM5440_ADC_CONDITION_TEST && !SM5440_ADC_TIMING_TEST
+	help
+	  Record eight bounded raw reads with pump OFF. READY is optional;
+	  raw values do not prove fresh conversion. Restore ADC controls and
+	  do not publish a charging companion, request PPS or activate charging.
+
 endif # POWER_SUPPLY
--- a/drivers/power/supply/Makefile
+++ b/drivers/power/supply/Makefile
@@ -142 +142,2 @@
 obj-$(CONFIG_SM5440_ADC_TIMING_TEST) += sm5440-timing.o
+obj-$(CONFIG_SM5440_ADC_RAW_TEST) += sm5440-timing.o
