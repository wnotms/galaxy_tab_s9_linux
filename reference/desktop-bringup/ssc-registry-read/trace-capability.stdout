        "qcom_glink_cmd_version": {
          "format": "name: qcom_glink_cmd_version\nID: 1148\nformat:\n\tfield:unsigned short common_type;\toffset:0;\tsize:2;\tsigned:0;\n\tfield:unsigned char common_flags;\toffset:2;\tsize:1;\tsigned:0;\n\tfield:unsigned char common_preempt_count;\toffset:3;\tsize:1;\tsigned:0;\n\tfield:int common_pid;\toffset:4;\tsize:4;\tsigned:1;\n\n\tfield:__data_loc char[] remote;\toffset:8;\tsize:4;\tsigned:0;\n\tfield:u32 version;\toffset:12;\tsize:4;\tsigned:0;\n\tfield:u32 features;\toffset:16;\tsize:4;\tsigned:0;\n\tfield:bool tx;\toffset:20;\tsize:1;\tsigned:0;\n\nprint fmt: \"%s remote: %s version: %u features: %#x\", REC->tx ? \"tx\" : \"rx\", __get_str(remote), REC->version, REC->features\n",
