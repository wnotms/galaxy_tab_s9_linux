[{"sha":"ba970587a0e1203b6a0934b5b9174886b4c4d24c","node_id":"C_kwDOACN7MtoAKGJhOTcwNTg3YTBlMTIwM2I2YTA5MzRiNWI5MTc0ODg2YjRjNGQyNGM","commit":{"author":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-09-12T15:09:14Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-09-12T17:01:54Z"},"message":"drm/msm/a6xx+: Increase GMU FW init timeout\n\nWe were using 10ms, kgsl uses 100ms.  In practice it is usually takes\nless than 10ms, but very occasionally goes a bit above 10ms, leading to\na \"GMU firmware inialization timed out\", from which point things go\nsouth.\n\nThere are probably some things that could be done to speed up init, like\nincreasing GMU freq.  But to be safe, increase the timeout to match\nkgsl.\n\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>\nReviewed-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/753014/\nMessage-ID: <20260912150915.28700-1-robin.clark@oss.qualcomm.com>","tree":{"sha":"0715adc33dc8dc532fa0a4b400d2fb90005874c5","url":"https://api.github.com/repos/torvalds/linux/git/trees/0715adc33dc8dc532fa0a4b400d2fb90005874c5"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/ba970587a0e1203b6a0934b5b9174886b4c4d24c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/ba970587a0e1203b6a0934b5b9174886b4c4d24c","html_url":"https://github.com/torvalds/linux/commit/ba970587a0e1203b6a0934b5b9174886b4c4d24c","comments_url":"https://api.github.com/repos/torvalds/linux/commits/ba970587a0e1203b6a0934b5b9174886b4c4d24c/comments","author":null,"committer":null,"parents":[{"sha":"a2b65837980a513cf24825bc4a50b0430e3391e7","url":"https://api.github.com/repos/torvalds/linux/commits/a2b65837980a513cf24825bc4a50b0430e3391e7","html_url":"https://github.com/torvalds/linux/commit/a2b65837980a513cf24825bc4a50b0430e3391e7"}]},{"sha":"df68029e639b490e8f5f7715135a8af29e1b6cda","node_id":"C_kwDOACN7MtoAKGRmNjgwMjllNjM5YjQ5MGU4ZjVmNzcxNTEzNWE4YWYyOWUxYjZjZGE","commit":{"author":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-07-29T15:55:49Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-07-29T18:56:02Z"},"message":"drm/msm/gem: Set resv before exposing obj\n\nDon't swap the resv object _after_ exposing the newly created obj in LRU\nor global objects list, as that creates a race condition where another\nthread could lock the object using the original (per-obj) resv, but then\nunlock after the resv is replaced.\n\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/743109/\nMessage-ID: <20260729155609.20190-13-robin.clark@oss.qualcomm.com>","tree":{"sha":"162a33b61189627365d4043f0d2eee15eb918f17","url":"https://api.github.com/repos/torvalds/linux/git/trees/162a33b61189627365d4043f0d2eee15eb918f17"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/df68029e639b490e8f5f7715135a8af29e1b6cda","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/df68029e639b490e8f5f7715135a8af29e1b6cda","html_url":"https://github.com/torvalds/linux/commit/df68029e639b490e8f5f7715135a8af29e1b6cda","comments_url":"https://api.github.com/repos/torvalds/linux/commits/df68029e639b490e8f5f7715135a8af29e1b6cda/comments","author":null,"committer":null,"parents":[{"sha":"695d2b042af032bdbbfe4a1db475de2a2024e320","url":"https://api.github.com/repos/torvalds/linux/commits/695d2b042af032bdbbfe4a1db475de2a2024e320","html_url":"https://github.com/torvalds/linux/commit/695d2b042af032bdbbfe4a1db475de2a2024e320"}]},{"sha":"a25fd4227f59b9147ae6d23336878c28e5437a4d","node_id":"C_kwDOACN7MtoAKGEyNWZkNDIyN2Y1OWI5MTQ3YWU2ZDIzMzM2ODc4YzI4ZTU0MzdhNGQ","commit":{"author":{"name":"Puranam V G Tejaswi","email":"puranam.tejaswi@oss.qualcomm.com","date":"2026-07-17T20:41:28Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-07-18T16:02:54Z"},"message":"drm/msm/a6xx: Add Adreno 722 support\n\nAdd support for Adreno A722, a member of the GEN1 A7xx family. It is\nderived from A730 and shares the same IP-level configurations: HWCG\nregisters, protected registers, GBIF CX registers and gmu_cgc_mode.\nMajor differences include lower cache/core counts, 1MB GMEM, no\nConcurrent Binning & LPAC support. Some of the peripheral blocks like\nRSCC are from A740 that resulted in updates to RSC layout.\n\nAdd a new entry to the catalog to describe the usual configuration and\nfew additional fixup mainly due to missing CB/LPAC features and updated\nRSC layout.\n\nSigned-off-by: Puranam V G Tejaswi <puranam.tejaswi@oss.qualcomm.com>\nSigned-off-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/740959/\nMessage-ID: <20260718-eliza-gpu-v2-3-64379dbebd7a@oss.qualcomm.com>\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>","tree":{"sha":"2543520704a65fcc662111555d1fe152ee825dc5","url":"https://api.github.com/repos/torvalds/linux/git/trees/2543520704a65fcc662111555d1fe152ee825dc5"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/a25fd4227f59b9147ae6d23336878c28e5437a4d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/a25fd4227f59b9147ae6d23336878c28e5437a4d","html_url":"https://github.com/torvalds/linux/commit/a25fd4227f59b9147ae6d23336878c28e5437a4d","comments_url":"https://api.github.com/repos/torvalds/linux/commits/a25fd4227f59b9147ae6d23336878c28e5437a4d/comments","author":null,"committer":null,"parents":[{"sha":"352116dbc4fc61ae22eae748da36e46a3f45f65c","url":"https://api.github.com/repos/torvalds/linux/commits/352116dbc4fc61ae22eae748da36e46a3f45f65c","html_url":"https://github.com/torvalds/linux/commit/352116dbc4fc61ae22eae748da36e46a3f45f65c"}]},{"sha":"352116dbc4fc61ae22eae748da36e46a3f45f65c","node_id":"C_kwDOACN7MtoAKDM1MjExNmRiYzRmYzYxYWUyMmVhZTc0OGRhMzZlNDZhM2Y0NWY2NWM","commit":{"author":{"name":"Akhil P Oommen","email":"akhilpo@oss.qualcomm.com","date":"2026-07-17T20:41:27Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-07-18T16:02:54Z"},"message":"drm/msm/a6xx: Rename GBIF_CX_CONFIG to a A6XX- variant register\n\nThe GBIF_CX_CONFIG register exists on GPUs prior to A8XX (it is used on\nA722, for example), so it should be tagged as an A6XX variant to match\nthe register spec. Widen its variant range from \"A8XX-\" to \"A6XX-\" in the\nregister XML and rename the generated macro accordingly at all existing\nusage sites.\n\nReviewed-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>\nReviewed-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>\nSigned-off-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/740957/\nMessage-ID: <20260718-eliza-gpu-v2-2-64379dbebd7a@oss.qualcomm.com>\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>","tree":{"sha":"2b03e7dab28d0ea8b96f6c4ba4a06d2a509b7b38","url":"https://api.github.com/repos/torvalds/linux/git/trees/2b03e7dab28d0ea8b96f6c4ba4a06d2a509b7b38"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/352116dbc4fc61ae22eae748da36e46a3f45f65c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/352116dbc4fc61ae22eae748da36e46a3f45f65c","html_url":"https://github.com/torvalds/linux/commit/352116dbc4fc61ae22eae748da36e46a3f45f65c","comments_url":"https://api.github.com/repos/torvalds/linux/commits/352116dbc4fc61ae22eae748da36e46a3f45f65c/comments","author":{"login":"akhilpo-qcom","id":223512500,"node_id":"U_kgDODVKHtA","avatar_url":"https://avatars.githubusercontent.com/u/223512500?v=4","gravatar_id":"","url":"https://api.github.com/users/akhilpo-qcom","html_url":"https://github.com/akhilpo-qcom","followers_url":"https://api.github.com/users/akhilpo-qcom/followers","following_url":"https://api.github.com/users/akhilpo-qcom/following{/other_user}","gists_url":"https://api.github.com/users/akhilpo-qcom/gists{/gist_id}","starred_url":"https://api.github.com/users/akhilpo-qcom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akhilpo-qcom/subscriptions","organizations_url":"https://api.github.com/users/akhilpo-qcom/orgs","repos_url":"https://api.github.com/users/akhilpo-qcom/repos","events_url":"https://api.github.com/users/akhilpo-qcom/events{/privacy}","received_events_url":"https://api.github.com/users/akhilpo-qcom/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"01bcc0398f43099acb407a6067481e635c3e1b84","url":"https://api.github.com/repos/torvalds/linux/commits/01bcc0398f43099acb407a6067481e635c3e1b84","html_url":"https://github.com/torvalds/linux/commit/01bcc0398f43099acb407a6067481e635c3e1b84"}]},{"sha":"d9108bfdb746edacdb05bd27959a4ae63c6c7f3f","node_id":"C_kwDOACN7MtoAKGQ5MTA4YmZkYjc0NmVkYWNkYjA1YmQyNzk1OWE0YWU2M2M2YzdmM2Y","commit":{"author":{"name":"Shivam Rawat","email":"shivrawa@qti.qualcomm.com","date":"2026-06-04T20:08:17Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-07-16T20:37:22Z"},"message":"drm/msm/a6xx: Fix stale rpmh votes after suspend\n\nThere are stale RPMH votes (BCM votes) observed after GMU suspend. This\nis because the rpmh stop sequences are skipped during gmu suspend. Fix\nthis and also move GMU to reset state to avoid any further activity.\n\nFixes: f248d5d5159a (\"drm/msm/a6xx: Fix PDC sleep sequence\")\nSigned-off-by: Shivam Rawat <shivrawa@qti.qualcomm.com>\nSigned-off-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nTested-by: Neil Armstrong <neil.armstrong@linaro.org> # on SM8650-HDK\nReviewed-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>\nReviewed-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/730652/\nMessage-ID: <20260605-assorted-fixes-june-v1-1-2caa04f7287c@oss.qualcomm.com>\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>","tree":{"sha":"af4f6a5581ae926a8c927eac4985d6402a1ca733","url":"https://api.github.com/repos/torvalds/linux/git/trees/af4f6a5581ae926a8c927eac4985d6402a1ca733"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/d9108bfdb746edacdb05bd27959a4ae63c6c7f3f","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/d9108bfdb746edacdb05bd27959a4ae63c6c7f3f","html_url":"https://github.com/torvalds/linux/commit/d9108bfdb746edacdb05bd27959a4ae63c6c7f3f","comments_url":"https://api.github.com/repos/torvalds/linux/commits/d9108bfdb746edacdb05bd27959a4ae63c6c7f3f/comments","author":{"login":"shivrawa","id":229147152,"node_id":"U_kgDODaiCEA","avatar_url":"https://avatars.githubusercontent.com/u/229147152?v=4","gravatar_id":"","url":"https://api.github.com/users/shivrawa","html_url":"https://github.com/shivrawa","followers_url":"https://api.github.com/users/shivrawa/followers","following_url":"https://api.github.com/users/shivrawa/following{/other_user}","gists_url":"https://api.github.com/users/shivrawa/gists{/gist_id}","starred_url":"https://api.github.com/users/shivrawa/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/shivrawa/subscriptions","organizations_url":"https://api.github.com/users/shivrawa/orgs","repos_url":"https://api.github.com/users/shivrawa/repos","events_url":"https://api.github.com/users/shivrawa/events{/privacy}","received_events_url":"https://api.github.com/users/shivrawa/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"be0e82b8e0c96649b8bc77a99ab0d185243b7659","url":"https://api.github.com/repos/torvalds/linux/commits/be0e82b8e0c96649b8bc77a99ab0d185243b7659","html_url":"https://github.com/torvalds/linux/commit/be0e82b8e0c96649b8bc77a99ab0d185243b7659"}]},{"sha":"d8bf2eddd6520c5806334a22d817f58df8c8c018","node_id":"C_kwDOACN7MtoAKGQ4YmYyZWRkZDY1MjBjNTgwNjMzNGEyMmQ4MTdmNThkZjhjOGMwMTg","commit":{"author":{"name":"Alexander Koskovich","email":"akoskovich@pm.me","date":"2026-05-28T09:48:47Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-05-29T14:07:30Z"},"message":"drm/msm/adreno: rename llc_mmio to cx_misc_mmio\n\nThis region is used for more than just LLCC, it also provides access to\nsoftware fuse values (raytracing, etc).\n\nRename relevant symbols from _llc to _cx_misc for use in a follow up\nchange that decouples this from LLCC.\n\nReviewed-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nReviewed-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>\nSigned-off-by: Alexander Koskovich <akoskovich@pm.me>\nPatchwork: https://patchwork.freedesktop.org/patch/728806/\nMessage-ID: <20260528-adreno-810-v7-3-7fe7fdd97fc2@pm.me>\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>","tree":{"sha":"6cd71bf19c0596cc500ed5acfa907a1814e9d181","url":"https://api.github.com/repos/torvalds/linux/git/trees/6cd71bf19c0596cc500ed5acfa907a1814e9d181"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/d8bf2eddd6520c5806334a22d817f58df8c8c018","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/d8bf2eddd6520c5806334a22d817f58df8c8c018","html_url":"https://github.com/torvalds/linux/commit/d8bf2eddd6520c5806334a22d817f58df8c8c018","comments_url":"https://api.github.com/repos/torvalds/linux/commits/d8bf2eddd6520c5806334a22d817f58df8c8c018/comments","author":{"login":"AKoskovich","id":19439046,"node_id":"MDQ6VXNlcjE5NDM5MDQ2","avatar_url":"https://avatars.githubusercontent.com/u/19439046?v=4","gravatar_id":"","url":"https://api.github.com/users/AKoskovich","html_url":"https://github.com/AKoskovich","followers_url":"https://api.github.com/users/AKoskovich/followers","following_url":"https://api.github.com/users/AKoskovich/following{/other_user}","gists_url":"https://api.github.com/users/AKoskovich/gists{/gist_id}","starred_url":"https://api.github.com/users/AKoskovich/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/AKoskovich/subscriptions","organizations_url":"https://api.github.com/users/AKoskovich/orgs","repos_url":"https://api.github.com/users/AKoskovich/repos","events_url":"https://api.github.com/users/AKoskovich/events{/privacy}","received_events_url":"https://api.github.com/users/AKoskovich/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"b780f888d9fc2303b666d30f5078c069e496fc71","url":"https://api.github.com/repos/torvalds/linux/commits/b780f888d9fc2303b666d30f5078c069e496fc71","html_url":"https://github.com/torvalds/linux/commit/b780f888d9fc2303b666d30f5078c069e496fc71"}]},{"sha":"632ad5510114eb3866bc519bd216860d48ccf77c","node_id":"C_kwDOACN7MtoAKDYzMmFkNTUxMDExNGViMzg2NmJjNTE5YmQyMTY4NjBkNDhjY2Y3N2M","commit":{"author":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-05-26T14:50:50Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-05-29T14:07:30Z"},"message":"drm/msm/a6xx: Allow IFPC with perfcntr stream\n\nNow that the dynamic pwrup reglist has SEL reg values to restore\nappended, so that SEL regs are restored on IFPC exit, we can stop\ncompletely disabling IFPC while global counter sampling is active.\n\nTo accomplish this, we re-use sysprof_setup() with a force_on param\nto inhibit IFPC specifically while the counter regs are being read,\nwhile leaving IFPC enabled the rest of the time.\n\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>\nReviewed-by: Anna Maniscalco <anna.maniscalco2000@gmail.com>\nReviewed-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/728219/\nMessage-ID: <20260526145137.160554-17-robin.clark@oss.qualcomm.com>","tree":{"sha":"6de851a97dee4e75c041fd107e217bf1f3a071db","url":"https://api.github.com/repos/torvalds/linux/git/trees/6de851a97dee4e75c041fd107e217bf1f3a071db"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/632ad5510114eb3866bc519bd216860d48ccf77c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/632ad5510114eb3866bc519bd216860d48ccf77c","html_url":"https://github.com/torvalds/linux/commit/632ad5510114eb3866bc519bd216860d48ccf77c","comments_url":"https://api.github.com/repos/torvalds/linux/commits/632ad5510114eb3866bc519bd216860d48ccf77c/comments","author":null,"committer":null,"parents":[{"sha":"45d4a295b307b67c8a05d5d31a31385d0893553c","url":"https://api.github.com/repos/torvalds/linux/commits/45d4a295b307b67c8a05d5d31a31385d0893553c","html_url":"https://github.com/torvalds/linux/commit/45d4a295b307b67c8a05d5d31a31385d0893553c"}]},{"sha":"4250923945d05311f41411e8e9d3cffc72a9c523","node_id":"C_kwDOACN7MtoAKDQyNTA5MjM5NDVkMDUzMTFmNDE0MTFlOGU5ZDNjZmZjNzJhOWM1MjM","commit":{"author":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-05-26T14:50:41Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-05-29T14:07:28Z"},"message":"drm/msm: Add sysprof accessors\n\nCurrently the sysprof param serves two functions, (a) disabling perfcntr\nclearing on context switch/preemption, and (b) disabling IFPC.  In the\nfuture, with kernel side global perfcntr collection/stream, the decision\nabout disabling IFPC will change.\n\nTo prepare for this, split out two helpers/accessors for the two\ndifferent cases.  For now, they are the same thing, but this will\nchange.\n\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>\nReviewed-by: Anna Maniscalco <anna.maniscalco2000@gmail.com>\nReviewed-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/728214/\nMessage-ID: <20260526145137.160554-8-robin.clark@oss.qualcomm.com>","tree":{"sha":"93b29eb5113926a8d90f4414254cfbf0037aa1b6","url":"https://api.github.com/repos/torvalds/linux/git/trees/93b29eb5113926a8d90f4414254cfbf0037aa1b6"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/4250923945d05311f41411e8e9d3cffc72a9c523","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/4250923945d05311f41411e8e9d3cffc72a9c523","html_url":"https://github.com/torvalds/linux/commit/4250923945d05311f41411e8e9d3cffc72a9c523","comments_url":"https://api.github.com/repos/torvalds/linux/commits/4250923945d05311f41411e8e9d3cffc72a9c523/comments","author":null,"committer":null,"parents":[{"sha":"c897d550f0b4efdb19e71622dc9ec0c5d1b4df70","url":"https://api.github.com/repos/torvalds/linux/commits/c897d550f0b4efdb19e71622dc9ec0c5d1b4df70","html_url":"https://github.com/torvalds/linux/commit/c897d550f0b4efdb19e71622dc9ec0c5d1b4df70"}]},{"sha":"586a34dafc08c4fa68d1b4673de24cd84d09df05","node_id":"C_kwDOACN7MtoAKDU4NmEzNGRhZmMwOGM0ZmE2OGQxYjQ2NzNkZTI0Y2Q4NGQwOWRmMDU","commit":{"author":{"name":"Akhil P Oommen","email":"akhilpo@oss.qualcomm.com","date":"2026-05-22T10:11:57Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-05-29T14:07:27Z"},"message":"drm/msm/a8xx: Fix RSCC offset\n\nIn A8xx, the RSCC block is part of GPU's register space. Update the\nvirtual base address of rscc to point to the correct address.\n\nFixes: 50e8a557d8d3 (\"drm/msm/a8xx: Add support for A8x GMU\")\nSigned-off-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/727117/\nMessage-ID: <20260522-glymur-gpu-dt-v5-1-562c406b210c@oss.qualcomm.com>\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>","tree":{"sha":"a9a6a54adfc74a530d39ca15f53bc5e065037e7e","url":"https://api.github.com/repos/torvalds/linux/git/trees/a9a6a54adfc74a530d39ca15f53bc5e065037e7e"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/586a34dafc08c4fa68d1b4673de24cd84d09df05","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/586a34dafc08c4fa68d1b4673de24cd84d09df05","html_url":"https://github.com/torvalds/linux/commit/586a34dafc08c4fa68d1b4673de24cd84d09df05","comments_url":"https://api.github.com/repos/torvalds/linux/commits/586a34dafc08c4fa68d1b4673de24cd84d09df05/comments","author":{"login":"akhilpo-qcom","id":223512500,"node_id":"U_kgDODVKHtA","avatar_url":"https://avatars.githubusercontent.com/u/223512500?v=4","gravatar_id":"","url":"https://api.github.com/users/akhilpo-qcom","html_url":"https://github.com/akhilpo-qcom","followers_url":"https://api.github.com/users/akhilpo-qcom/followers","following_url":"https://api.github.com/users/akhilpo-qcom/following{/other_user}","gists_url":"https://api.github.com/users/akhilpo-qcom/gists{/gist_id}","starred_url":"https://api.github.com/users/akhilpo-qcom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akhilpo-qcom/subscriptions","organizations_url":"https://api.github.com/users/akhilpo-qcom/orgs","repos_url":"https://api.github.com/users/akhilpo-qcom/repos","events_url":"https://api.github.com/users/akhilpo-qcom/events{/privacy}","received_events_url":"https://api.github.com/users/akhilpo-qcom/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"fb495a57d66e791144ad1da898914b97a87853d6","url":"https://api.github.com/repos/torvalds/linux/commits/fb495a57d66e791144ad1da898914b97a87853d6","html_url":"https://github.com/torvalds/linux/commit/fb495a57d66e791144ad1da898914b97a87853d6"}]},{"sha":"fb495a57d66e791144ad1da898914b97a87853d6","node_id":"C_kwDOACN7MtoAKGZiNDk1YTU3ZDY2ZTc5MTE0NGFkMWRhODk4OTE0Yjk3YTg3ODUzZDY","commit":{"author":{"name":"Akhil P Oommen","email":"akhilpo@oss.qualcomm.com","date":"2026-04-27T06:39:00Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-05-29T14:07:27Z"},"message":"drm/msm/a6xx: Limit GXPD votes to recovery in A8x\n\nIn A8x GPUs, the GX GDSC is moved to a separate block called GXCLKCTL\nwhich is under the GX power domain. Due to the way the support for this\nblock is implemented in its driver, pm_runtime votes result in a vote on\nGX/GMxC/MxC rails from the APPS RSC. This is against the Adreno\narchitecture which require GMU to be the sole voter of these collapsible\nrails on behalf of GPU, except during the GPU/GMU recovery.\n\nTo align with this architectural requirement and to realize the power\nbenefits of the IFPC feature, remove the GXPD votes during gmu resume\nand suspend. And during the recovery sequence, enable/disable the GXPD\nalong with the 'synced_poweroff' genpd hint to force collapse this GDSC.\n\nSigned-off-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nSigned-off-by: Taniya Das <taniya.das@oss.qualcomm.com>\nReviewed-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/720979/\nMessage-ID: <20260427-gfx-clk-fixes-v2-6-797e54b3d464@oss.qualcomm.com>\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>","tree":{"sha":"8ac0130b3f8f0fb2f916c6cc6ee1b9ef45355ac1","url":"https://api.github.com/repos/torvalds/linux/git/trees/8ac0130b3f8f0fb2f916c6cc6ee1b9ef45355ac1"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/fb495a57d66e791144ad1da898914b97a87853d6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/fb495a57d66e791144ad1da898914b97a87853d6","html_url":"https://github.com/torvalds/linux/commit/fb495a57d66e791144ad1da898914b97a87853d6","comments_url":"https://api.github.com/repos/torvalds/linux/commits/fb495a57d66e791144ad1da898914b97a87853d6/comments","author":{"login":"akhilpo-qcom","id":223512500,"node_id":"U_kgDODVKHtA","avatar_url":"https://avatars.githubusercontent.com/u/223512500?v=4","gravatar_id":"","url":"https://api.github.com/users/akhilpo-qcom","html_url":"https://github.com/akhilpo-qcom","followers_url":"https://api.github.com/users/akhilpo-qcom/followers","following_url":"https://api.github.com/users/akhilpo-qcom/following{/other_user}","gists_url":"https://api.github.com/users/akhilpo-qcom/gists{/gist_id}","starred_url":"https://api.github.com/users/akhilpo-qcom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akhilpo-qcom/subscriptions","organizations_url":"https://api.github.com/users/akhilpo-qcom/orgs","repos_url":"https://api.github.com/users/akhilpo-qcom/repos","events_url":"https://api.github.com/users/akhilpo-qcom/events{/privacy}","received_events_url":"https://api.github.com/users/akhilpo-qcom/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"e7c45d9838b7487c1846a0202c649336b2f5bf87","url":"https://api.github.com/repos/torvalds/linux/commits/e7c45d9838b7487c1846a0202c649336b2f5bf87","html_url":"https://github.com/torvalds/linux/commit/e7c45d9838b7487c1846a0202c649336b2f5bf87"}]},{"sha":"bb9b1d6e945ea90459bda1aac7e2aa7179119887","node_id":"C_kwDOACN7MtoAKGJiOWIxZDZlOTQ1ZWE5MDQ1OWJkYTFhYWM3ZTJhYTcxNzkxMTk4ODc","commit":{"author":{"name":"Akhil P Oommen","email":"akhilpo@oss.qualcomm.com","date":"2026-03-27T00:13:55Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-03-31T20:47:29Z"},"message":"drm/msm/a6xx: Fix gpu init from secure world\n\nA7XX_GEN2 and newer GPUs requires initialization of few configurations\nrelated to features/power from secure world. The SCM call to do this\nshould be triggered after GDSC and clocks are enabled. So, keep this\nsequence to a6xx_gmu_resume instead of the probe.\n\nAlso, simplify the error handling in a6xx_gmu_resume() using 'goto'\nlabels.\n\nFixes: 14b27d5df3ea (\"drm/msm/a7xx: Initialize a750 \"software fuse\"\")\nSigned-off-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/714664/\nMessage-ID: <20260327-a8xx-gpu-batch2-v2-6-2b53c38d2101@oss.qualcomm.com>\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>","tree":{"sha":"741815cb8e793d97409d2238f0257dfa44209720","url":"https://api.github.com/repos/torvalds/linux/git/trees/741815cb8e793d97409d2238f0257dfa44209720"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/bb9b1d6e945ea90459bda1aac7e2aa7179119887","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/bb9b1d6e945ea90459bda1aac7e2aa7179119887","html_url":"https://github.com/torvalds/linux/commit/bb9b1d6e945ea90459bda1aac7e2aa7179119887","comments_url":"https://api.github.com/repos/torvalds/linux/commits/bb9b1d6e945ea90459bda1aac7e2aa7179119887/comments","author":{"login":"akhilpo-qcom","id":223512500,"node_id":"U_kgDODVKHtA","avatar_url":"https://avatars.githubusercontent.com/u/223512500?v=4","gravatar_id":"","url":"https://api.github.com/users/akhilpo-qcom","html_url":"https://github.com/akhilpo-qcom","followers_url":"https://api.github.com/users/akhilpo-qcom/followers","following_url":"https://api.github.com/users/akhilpo-qcom/following{/other_user}","gists_url":"https://api.github.com/users/akhilpo-qcom/gists{/gist_id}","starred_url":"https://api.github.com/users/akhilpo-qcom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akhilpo-qcom/subscriptions","organizations_url":"https://api.github.com/users/akhilpo-qcom/orgs","repos_url":"https://api.github.com/users/akhilpo-qcom/repos","events_url":"https://api.github.com/users/akhilpo-qcom/events{/privacy}","received_events_url":"https://api.github.com/users/akhilpo-qcom/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"ae25e6e9cdcac4cfef102b9d6de8bff13ca4d13b","url":"https://api.github.com/repos/torvalds/linux/commits/ae25e6e9cdcac4cfef102b9d6de8bff13ca4d13b","html_url":"https://github.com/torvalds/linux/commit/ae25e6e9cdcac4cfef102b9d6de8bff13ca4d13b"}]},{"sha":"ae25e6e9cdcac4cfef102b9d6de8bff13ca4d13b","node_id":"C_kwDOACN7MtoAKGFlMjVlNmU5Y2RjYWM0Y2ZlZjEwMmI5ZDZkZThiZmYxM2NhNGQxM2I","commit":{"author":{"name":"Akhil P Oommen","email":"akhilpo@oss.qualcomm.com","date":"2026-03-27T00:13:54Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-03-31T20:47:29Z"},"message":"drm/msm/adreno: Implement gx_is_on() for A8x\n\nA8x has a diverged enough for a separate implementation of gx_is_on()\ncheck. Add that and move them to the adreno func table.\n\nFixes: 288a93200892 (\"drm/msm/adreno: Introduce A8x GPU Support\")\nReviewed-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>\nSigned-off-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/714661/\nMessage-ID: <20260327-a8xx-gpu-batch2-v2-5-2b53c38d2101@oss.qualcomm.com>\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>","tree":{"sha":"cf6e79102a32444e79fd4c69b38efff93be79214","url":"https://api.github.com/repos/torvalds/linux/git/trees/cf6e79102a32444e79fd4c69b38efff93be79214"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/ae25e6e9cdcac4cfef102b9d6de8bff13ca4d13b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/ae25e6e9cdcac4cfef102b9d6de8bff13ca4d13b","html_url":"https://github.com/torvalds/linux/commit/ae25e6e9cdcac4cfef102b9d6de8bff13ca4d13b","comments_url":"https://api.github.com/repos/torvalds/linux/commits/ae25e6e9cdcac4cfef102b9d6de8bff13ca4d13b/comments","author":{"login":"akhilpo-qcom","id":223512500,"node_id":"U_kgDODVKHtA","avatar_url":"https://avatars.githubusercontent.com/u/223512500?v=4","gravatar_id":"","url":"https://api.github.com/users/akhilpo-qcom","html_url":"https://github.com/akhilpo-qcom","followers_url":"https://api.github.com/users/akhilpo-qcom/followers","following_url":"https://api.github.com/users/akhilpo-qcom/following{/other_user}","gists_url":"https://api.github.com/users/akhilpo-qcom/gists{/gist_id}","starred_url":"https://api.github.com/users/akhilpo-qcom/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/akhilpo-qcom/subscriptions","organizations_url":"https://api.github.com/users/akhilpo-qcom/orgs","repos_url":"https://api.github.com/users/akhilpo-qcom/repos","events_url":"https://api.github.com/users/akhilpo-qcom/events{/privacy}","received_events_url":"https://api.github.com/users/akhilpo-qcom/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":null,"parents":[{"sha":"d34b6919798c1a8c93e1d7cca297d0e068146bd5","url":"https://api.github.com/repos/torvalds/linux/commits/d34b6919798c1a8c93e1d7cca297d0e068146bd5","html_url":"https://github.com/torvalds/linux/commit/d34b6919798c1a8c93e1d7cca297d0e068146bd5"}]}]