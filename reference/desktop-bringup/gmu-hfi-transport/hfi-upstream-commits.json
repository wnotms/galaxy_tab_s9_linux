[{"sha":"b5c7a7f452b885bfbe102bd3a057a5f496802f8b","node_id":"C_kwDOACN7MtoAKGI1YzdhN2Y0NTJiODg1YmZiZTEwMmJkM2EwNTdhNWY0OTY4MDJmOGI","commit":{"author":{"name":"Chen Ni","email":"nichen@iscas.ac.cn","date":"2026-04-28T07:35:58Z"},"committer":{"name":"Rob Clark","email":"robin.clark@oss.qualcomm.com","date":"2026-05-13T21:37:54Z"},"message":"drm/msm/a6xx: Check kzalloc return in a8xx_hfi_send_perf_table\n\nCheck the return value of kzalloc() to prevent a NULL pointer\ndereference on allocation failure.\n\nFixes: 06cfbca0e1c6 (\"drm/msm/a6xx: Share dependency vote table with GMU\")\nSigned-off-by: Chen Ni <nichen@iscas.ac.cn>\nReviewed-by: Dmitry Baryshkov <dmitry.baryshkov@oss.qualcomm.com>\nReviewed-by: Akhil P Oommen <akhilpo@oss.qualcomm.com>\nPatchwork: https://patchwork.freedesktop.org/patch/721342/\nMessage-ID: <20260428073558.1234238-1-nichen@iscas.ac.cn>\nSigned-off-by: Rob Clark <robin.clark@oss.qualcomm.com>","tree":{"sha":"125da4e40ee2e7a20c52f762d6a2f203b1cb6012","url":"https://api.github.com/repos/torvalds/linux/git/trees/125da4e40ee2e7a20c52f762d6a2f203b1cb6012"},"url":"https://api.github.com/repos/torvalds/linux/git/commits/b5c7a7f452b885bfbe102bd3a057a5f496802f8b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/torvalds/linux/commits/b5c7a7f452b885bfbe102bd3a057a5f496802f8b","html_url":"https://github.com/torvalds/linux/commit/b5c7a7f452b885bfbe102bd3a057a5f496802f8b","comments_url":"https://api.github.com/repos/torvalds/linux/commits/b5c7a7f452b885bfbe102bd3a057a5f496802f8b/comments","author":null,"committer":null,"parents":[{"sha":"55e0f0d1c1a4ee1e46da7da4d443eb3044fb3851","url":"https://api.github.com/repos/torvalds/linux/commits/55e0f0d1c1a4ee1e46da7da4d443eb3044fb3851","html_url":"https://github.com/torvalds/linux/commit/55e0f0d1c1a4ee1e46da7da4d443eb3044fb3851"}]},{"sha":"742b4e88cddb9840234623db9f3dc06a4d7c9135","node_id":"C_kwDOACN7M