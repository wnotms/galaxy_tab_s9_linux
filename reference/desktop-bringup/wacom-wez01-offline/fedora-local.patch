--- Fedora/ab123e7d/wacom-wez01.c
+++ optional/wacom-wez01.c
@@ -200,11 +200,16 @@
 		return IRQ_HANDLED;
 
 	if (!(data[0] & WEZ01_RDY)) {
-		timer_shutdown_sync(&w->prox_timer);
+		timer_delete_sync(&w->prox_timer);
 		wacom_wez01_leave_range(w);
 		return IRQ_HANDLED;
 	}
 
