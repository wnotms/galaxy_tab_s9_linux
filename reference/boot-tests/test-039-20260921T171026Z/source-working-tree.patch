+/*
+ * EXPERIMENT (test 039): DSC is off by default in this build.  The panel
+ * receives frames - the owner sees the console text collapsed into a few faint
+ * lines - but the picture only decodes partially, and the suspicion is the
+ * DDIC's own DSC setup: the stock SM-X710 DTBO carries no DCS sequence at all
+ * (its on-command string is Samsung macros this port cannot read), so the
+ * compression registers here come from the SM-X910's panel.  With DSC off the
+ * frame goes over the link as plain 24 bpp RGB, exactly as the DDIC sees it in
+ * any non-compressed configuration, which isolates the compression path from
+ * everything else.  It has to be a built-time default because the msm DSI host
+ * reads dsi->dsc once, at attach time, before any module parameter could be
+ * changed at runtime.
+ */
+static bool dsc;
+module_param(dsc, bool, 0644);
+MODULE_PARM_DESC(dsc, "Drive the panel with DSC compression (the stock configuration)");
+
 /* Revision D, as read back by the bootloader (lcd_id=0x800004). */
 static const u8 ana38407_expected_id[3] = { 0x80, 0x00, 0x04 };
 
@@ -392,13 +409,16 @@ static int ana38407_on(struct ana38407 *ctx)
 	 * DSC: enable compression and send the Picture Parameter Set as a proper
 	 * MIPI PPS packet generated from drm_dsc_config (this is how mainline
 	 * command-mode DSC panels do it; a hand-rolled DCS 0x0A long write is the
-	 * wrong packet type).
+	 * wrong packet type).  Skipped entirely when the dsc parameter is off, so
+	 * that the DDIC expects plain RGB and the DSI host sends it.
 	 */
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
-	mipi_dsi_compression_mode_multi(&dsi_ctx, true);
-	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
-	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
-	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	if (dsc) {
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0x5a, 0x5a);
+		mipi_dsi_compression_mode_multi(&dsi_ctx, true);
+		drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+		mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+		mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf0, 0xa5, 0xa5);
+	}
 
 	/* DIA_SETTING (digital image adjust on) */
 	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x91, 0x02);
@@ -556,20 +576,17 @@ out_unlock:
