[Unit]
Description=Test401 bounded native SMP2P and GLINK boot trace
After=local-fs.target
Before=multi-user.target
ConditionPathExists=/var/lib/gts9-test401/text-scope

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/gts9-test401/glink_trace.py watch
Restart=no
TimeoutStopSec=3s
RuntimeMaxSec=310s
