+/* power_supply capacity is a percentage, not a charge or energy reading. */
+static int get_percentage_value(const char *value)
+{
+    char *end;
+    long percentage;
+
+    errno = 0;
+    percentage = strtol(value, &end, 10);
+    if (end == value || errno || percentage < 0 || percentage > 100)
+        return -1;
+    while (isspace((unsigned char)*end))
+        end++;
+    return *end ? -1 : (int)percentage;
+}
