[Unit]
Description=Qualified X710 Wacom and palm-aware touchscreen pair
After=local-fs.target systemd-udevd.service
Before=gdm.service
Conflicts=gts9-touch.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/gts9-palm --load
RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=gdm.service
