#!/bin/sh
# gts9-prev-boot-evidence - archive the previous boot's evidence at every boot.
#
# The X710 stall wedges the microSD path (mmc1 timeouts in the stall reports),
# so the journal of a stalled boot can stop within seconds of the wedge and the
# trace recorder can be cut off mid-file.
#
# CORRECTION (round 22): pstore DOES survive the stall on this port, and the
# comment that used to stand here - "/sys/fs/pstore is empty (CONFIG_PSTORE_RAM=y
# but no ramoops node)" - was wrong twice over.  CONFIG_PSTORE_RAM=y and the
# ramoops node is present (`ramoops@880900000`, 2 MiB), and dmesg shows
# `pstore: Registered ramoops as persistent store backend` plus
# `printk: legacy console [ramoops-1] enabled`.  On 2026-09-25 that record held
# the complete post-mortem of a failed boot - the DPU flood, two SDHCI timeouts,
# an RPMh timeout, an RCU stall, the soft-lockup panic - and this collector
# archived none of it, because it looked in the wrong directory:
#
#   systemd-pstore.service runs BEFORE this unit, MOVES every record from
#   /sys/fs/pstore to /var/lib/systemd/pstore, and deletes the originals.
#
# So the records were on disk the whole time, one directory away, and every
# verdict this script has ever written said pstore_records= (empty).  Both
# directories are searched now.
#
# What survives is the previous boot's journal *up to* the wedge, the pstore
# records (which carry the panic), and the trace files the recorder already wrote
# to the microSD.  This helper collects them into one directory per boot so the
# next round starts from a known place, and distils the stall markers into a
# handful of lines that can be read back over a 115200 baud console in seconds:
#
#	/var/log/gts9-boot-evidence/<utc>-<boot_id8>/
#	    verdict.txt          key=value summary of the previous boot
#	    prev-kernel.log      journalctl -b -1 -k -o short-monotonic
#	    prev-all.log         journalctl -b -1 -o short-monotonic
#	    pstore/              every record, from both directories
#	    stream-prev-tail.txt last 80 lines of the trace recorder's .prev
#	    stream-prev1-tail.txt last 80 lines of its .1.prev
#	    watchdog.txt         watchdog state at this boot
#
# It is informational only: it never changes a kernel parameter, never fails a
# boot, and keeps only the newest few directories.

set -u

DEST_ROOT=/var/log/gts9-boot-evidence
KEEP=8
STREAM=/var/log/gts9-dpu-stream.txt

boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)
short_id=$(echo "$boot_id" | cut -c1-8)
stamp=$(date -u +%Y%m%dT%H%M%SZ 2>/dev/null || echo notime)
dir=$DEST_ROOT/$stamp-$short_id

mkdir -p "$dir" || exit 0

echo "$boot_id" >"$dir/boot-id.txt" 2>/dev/null || true
cut -d' ' -f1 /proc/uptime >"$dir/uptime.txt" 2>/dev/null || true
cat /proc/cmdline >"$dir/cmdline.txt" 2>/dev/null || true
dmesg 2>/dev/null | grep -a -E 'Kernel command line|watchdog' | head -20 >"$dir/dmesg-watchdog.txt" 2>/dev/null || true

# --- previous boot, from the journal -----------------------------------------
prev_state=none
if journalctl -b -1 -k -o short-monotonic --no-pager >"$dir/prev-kernel.log" 2>/dev/null; then
	if [ -s "$dir/prev-kernel.log" ]; then
		prev_state=present
	else
		prev_state=empty
	fi
fi
journalctl -b -1 -o short-monotonic --no-pager >"$dir/prev-all.log" 2>/dev/null || true

# --- which boot does that journal actually describe? --------------------------
# The directory name and boot_id= below both identify the boot that is RUNNING
# NOW, because that is the boot that can do the collecting.  Everything the
# archive is really about - prev-kernel.log, prev-all.log, and every marker_ and
# previous_boot_end= field - describes the boot BEFORE this one, whose id was
# otherwise recorded nowhere.  That gap let two archived failures get cited by
# the id of the boots that recovered from them.
#
# Taken from the same `-b -1` selection that produced prev-kernel.log, so the id
# cannot name a different boot than the log does.  `-n 1` keeps it cheap: any
# single record of that boot carries the same _BOOT_ID.
prev_boot_id=""
if [ "$prev_state" = present ]; then
	prev_boot_id=$(journalctl -b -1 -o verbose --no-pager -n 1 2>/dev/null \
		| sed -n 's/^ *_BOOT_ID=//p' | head -1)
	if [ -z "$prev_boot_id" ]; then
		# -o verbose is not guaranteed; fall back to the boot table.
		prev_boot_id=$(journalctl --list-boots --no-pager 2>/dev/null \
			| awk '$1 == -1 { print $2; exit }')
	fi
fi

# --- previous boot, from pstore ----------------------------------------------
# A panic report never reaches the journal (journald does not run at panic time)
# but the ramoops console buffer does keep it across the reset.  Copy it before
# anything can delete or overwrite it: this is the only place the panic stack
# survives on this port.
#
# BOTH directories, and /var/lib/systemd/pstore FIRST: systemd-pstore moves the
# records there before this unit runs and deletes the originals, so
# /sys/fs/pstore is normally empty by now.  Reading only /sys/fs/pstore is the
# bug that lost the 2026-09-25 post-mortem.  First copy of a name wins, so the
# archived (previous-boot) record is preferred over a same-named fresh one.
mkdir -p "$dir/pstore" 2>/dev/null || true
pstore_list=""
for src in /var/lib/systemd/pstore /sys/fs/pstore; do
	[ -d "$src" ] || continue
	for rec in "$src"/*; do
		[ -f "$rec" ] || continue
		name=${rec##*/}
		[ -e "$dir/pstore/$name" ] && continue
		cp "$rec" "$dir/pstore/$name" 2>/dev/null || continue
		pstore_list="$pstore_list$name "
	done
done
echo "$pstore_list" >"$dir/pstore/list.txt" 2>/dev/null || true

grep -a -n -E 'Kernel panic|BUG: soft lockup|BUG: hard LOCKUP|watchdog: BUG|watchdog: watch|unable to handle|hung_task|blocked for more than|rcu.*detected stall|rcu.*starved|frame done timeout|kickoff timeout|Timeout waiting for hardware cmd interrupt|sdhci: =|Call trace|task:|Workqueue:' \
	"$dir/prev-kernel.log" 2>/dev/null | tail -120 >"$dir/prev-signatures.txt" 2>/dev/null || true

# count_in FILE PATTERN - same, for an arbitrary file.
count_in() {
	local n
	n=$(grep -a -c -E "$2" "$1" 2>/dev/null)
	printf '%s' "${n:-0}"
}

# count PATTERN - one number, always.  `grep -c` already prints 0 on no match
# and exits 1, so `|| echo 0` would print a second 0 and split every verdict
# line in two.
count() {
	local n
	n=$(grep -a -c -E "$1" "$dir/prev-kernel.log" 2>/dev/null)
	printf '%s' "${n:-0}"
}

panic=$(count 'Kernel panic')
lockup=$(count 'BUG: soft lockup|watchdog: BUG')
hardlock=$(count 'BUG: hard LOCKUP|Hard LOCKUP')
hung=$(count 'hung_task|blocked for more than')
rcu=$(count 'rcu.*detected stall|rcu.*starved')
dpu=$(count 'frame done timeout|kickoff timeout')
mmc=$(count 'Timeout waiting for hardware cmd interrupt|sdhci: =')

# The pstore console record is the authoritative "did it panic" evidence.  It is
# also the only evidence at all when the failing boot left no journal - which is
# what happened on 2026-09-25: the boot wedged at ~6.8 s, journald never flushed,
# and every journal-derived counter below read 0 while the pstore record held the
# whole story.  So the same markers are counted from pstore separately.
pstore_panic=0
pstore_lockup=0
pstore_rcu=0
pstore_dpu=0
pstore_mmc=0
pstore_hung=0
for rec in "$dir"/pstore/*; do
	[ -f "$rec" ] || continue
	pstore_panic=$((pstore_panic + $(count_in "$rec" 'Kernel panic')))
	pstore_lockup=$((pstore_lockup + $(count_in "$rec" 'BUG: soft lockup|watchdog: BUG|workqueue: stall|hung_task: blocked')))
	pstore_rcu=$((pstore_rcu + $(count_in "$rec" 'rcu.*detected stall|rcu.*starved')))
	pstore_dpu=$((pstore_dpu + $(count_in "$rec" 'frame done timeout|kickoff timeout')))
	pstore_mmc=$((pstore_mmc + $(count_in "$rec" 'Timeout waiting for hardware|sdhci: =')))
	pstore_hung=$((pstore_hung + $(count_in "$rec" 'hung_task|blocked for more than')))
done

if [ "$pstore_panic" -gt 0 ]; then
	prev_end=panic
elif grep -a -q 'systemd-shutdown' "$dir/prev-all.log" 2>/dev/null; then
	prev_end=clean-shutdown
elif grep -a -q 'Kernel panic' "$dir/prev-kernel.log" 2>/dev/null; then
	prev_end=panic
elif [ "$prev_state" = none ]; then
	prev_end=unknown
else
	prev_end=hard-reset-or-incomplete
fi

{
	echo "collected_utc=$stamp"
	echo "boot_id=$boot_id"
	echo "previous_boot=$prev_state"
	echo "previous_boot_id=$prev_boot_id"
	echo "previous_boot_end=$prev_end"
	echo "prev_kernel_lines=$(wc -l <"$dir/prev-kernel.log" 2>/dev/null || echo 0)"
	echo "marker_panic=$panic"
	echo "marker_soft_lockup=$lockup"
	echo "marker_hard_lockup=$hardlock"
	echo "marker_hung_task=$hung"
	echo "marker_rcu_stall=$rcu"
	echo "marker_dpu_timeout=$dpu"
	echo "marker_mmc_timeout=$mmc"
	echo "pstore_records=$pstore_list"
	echo "pstore_panic_lines=$pstore_panic"
	echo "pstore_lockup_lines=$pstore_lockup"
	echo "pstore_rcu_lines=$pstore_rcu"
	echo "pstore_dpu_lines=$pstore_dpu"
	echo "pstore_mmc_lines=$pstore_mmc"
	echo "pstore_hung_lines=$pstore_hung"
	# When the failing boot left no journal, every marker_ above is 0 by
	# construction and the pstore_ markers are the real answer.  Say so, so a
	# verdict of "all zero" cannot be read as "nothing happened".
	if [ -s "$dir/prev-kernel.log" ]; then
		echo "prev_journal=present"
	else
		echo "prev_journal=absent-pstore-is-authoritative"
	fi
	echo "watchdog_enabled=$(cat /proc/sys/kernel/watchdog 2>/dev/null || echo absent)"
	echo "softlockup_panic=$(cat /proc/sys/kernel/softlockup_panic 2>/dev/null || echo absent)"
	echo "hung_task_panic=$(cat /proc/sys/kernel/hung_task_panic 2>/dev/null || echo absent)"
	echo "wq_panic_on_stall_time=$(cat /sys/module/workqueue/parameters/panic_on_stall_time 2>/dev/null || echo absent)"
} >"$dir/verdict.txt" 2>/dev/null || true

# --- trace recorder, before it rotates the files itself ----------------------
mkdir -p "$dir/stream" 2>/dev/null || true
ls -l "$STREAM"* >"$dir/stream/ls.txt" 2>/dev/null || true
for which in prev 1.prev; do
	f=$STREAM.$which
	[ -f "$f" ] || continue
	case $which in
	prev) out=$dir/stream/stream-prev-tail.txt ;;
	*) out=$dir/stream/stream-prev1-tail.txt ;;
	esac
	{
		echo "# $f size=$(wc -c <"$f" 2>/dev/null)"
		echo "# first line:"
		head -1 "$f" 2>/dev/null | cut -c1-200
		echo "# last 80 lines:"
		tail -80 "$f" 2>/dev/null | cut -c1-200
	} >"$out" 2>/dev/null || true
done

# --- watchdog state at this boot ---------------------------------------------
{
	echo "watchdog=$(cat /proc/sys/kernel/watchdog 2>/dev/null || echo absent)"
	echo "watchdog_thresh=$(cat /proc/sys/kernel/watchdog_thresh 2>/dev/null || echo absent)"
	echo "softlockup_panic=$(cat /proc/sys/kernel/softlockup_panic 2>/dev/null || echo absent)"
	echo "softlockup_all_cpu_backtrace=$(cat /proc/sys/kernel/softlockup_all_cpu_backtrace 2>/dev/null || echo absent)"
	echo "hung_task_timeout_secs=$(cat /proc/sys/kernel/hung_task_timeout_secs 2>/dev/null || echo absent)"
	echo "hung_task_panic=$(cat /proc/sys/kernel/hung_task_panic 2>/dev/null || echo absent)"
	echo "panic=$(cat /proc/sys/kernel/panic 2>/dev/null || echo absent)"
	echo "workqueue.panic_on_stall=$(cat /sys/module/workqueue/parameters/panic_on_stall 2>/dev/null || echo absent)"
	echo "workqueue.panic_on_stall_time=$(cat /sys/module/workqueue/parameters/panic_on_stall_time 2>/dev/null || echo absent)"
	echo "workqueue.watchdog_thresh=$(cat /sys/module/workqueue/parameters/watchdog_thresh 2>/dev/null || echo absent)"
	echo "dev_watchdog=$(ls /dev/watchdog* 2>/dev/null | tr '\n' ' ' || echo none)"
	echo "pstore=$(ls -A /sys/fs/pstore 2>/dev/null | tr '\n' ' ' || echo none)"
	cat /var/log/gts9-watchdog-debug.txt 2>/dev/null || true
} >"$dir/watchdog.txt" 2>/dev/null || true

# --- keep the newest few ------------------------------------------------------
if [ -d "$DEST_ROOT" ]; then
	ls -1dt "$DEST_ROOT"/*/ 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r old; do
		case "$old" in
		"$DEST_ROOT"/*/) rm -rf "$old" 2>/dev/null || true ;;
		esac
	done
fi

echo "gts9-prev-boot-evidence: $dir previous_boot=$prev_state end=$prev_end panic=$panic lockup=$lockup hung=$hung rcu=$rcu dpu=$dpu mmc=$mmc"
exit 0
