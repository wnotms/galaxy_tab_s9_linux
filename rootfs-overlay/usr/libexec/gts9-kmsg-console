#!/bin/sh
# gts9-kmsg-console - mirror kernel messages onto the USB link.
#
# Why this exists
# ---------------
# The USB cable is the only channel off this tablet that survives a userspace
# that has stopped, and it is a *userspace* channel: the kernel command line is
#
#	console=tty0
#
# and nothing else.  printk goes to the panel VT alone, so nothing from the
# kernel reaches the host by itself - a panic test on 2026-09-24 lost the panic
# report completely, because the gadget only came back after the reboot and the
# kernel log of the dead boot was gone with it.
#
# The stall evidence we do have - the soft-lockup report, the enc35 frame-done
# timeouts, the RCU stalls - reached us as photographs of the tablet's screen,
# which is not something an unattended loop can use.  This helper copies
# /dev/kmsg to /dev/ttyGS0 as it is written, so the same messages land in the
# host's serial capture with correct ordering.
#
# Update 2026-09-26: the serial *consoles* were removed (docs/BOOT_CONSOLE_BLOCK.md,
# docs/SHUTDOWN_DELAY.md) but this mirror is not a console and is not one of them.
# It writes to an opened tty from an ordinary userspace process, which is bounded
# and reopenable, rather than being wired into printk and /dev/console.  It stays
# opt-in behind gts9_kmsg_mirror=1: it is a loud piece of instrumentation, and on
# a normal boot `dmesg` over ssh is the better tool.
#
# It cannot capture the panic message itself: panic() runs on one CPU with the
# others stopped and schedules nothing, so a userspace reader never gets to see
# the final lines.  Everything *leading up to* the panic arrives, which is what
# the stall analysis needs; capturing the panic line needs a persistent store
# (ramoops) and is tracked separately.
#
# Usage: gts9-kmsg-console [device] [--force]      (default /dev/ttyGS0)
#
# Gated on its *own* command-line flag, not on the watchdog profile: mirroring
# the whole kernel log onto the USB link is a second, much louder piece of
# instrumentation, and it must be possible to measure the stall with the
# watchdog detectors alone (observer-effect A/B).  Flags:
#
#	gts9_watchdog_debug=1   detectors only
#	gts9_kmsg_mirror=1      the mirror below
#	gts9_dpu_flight=1       the DPU ftrace stream (gts9-dpu-flight.service)

set -u

DEV=${1:-/dev/ttyGS0}
case "${2:-}" in
--force) FORCE=1 ;;
*) FORCE=0 ;;
esac
FLAG=gts9_kmsg_mirror=1

if [ "$FORCE" != 1 ]; then
	case " $(cat /proc/cmdline 2>/dev/null) " in
	*" $FLAG "*) ;;
	*)
		echo "gts9-kmsg-console: $FLAG not on the command line; not mirroring"
		exit 0
		;;
	esac
fi

# If the kernel already has a console on the USB link (console=ttyGS1 in the
# command line with CONFIG_U_SERIAL_CONSOLE), this mirror is redundant: printk
# goes to the same port by itself, earlier and without a userspace reader in
# the path.  Step aside rather than printing everything twice.
if grep -qa 'ttyGS' /sys/class/tty/console/active 2>/dev/null; then
	echo "gts9-kmsg-console: ttyGS is already a kernel console; not mirroring"
	exit 0
fi

command -v dmesg >/dev/null 2>&1 || {
	echo "gts9-kmsg-console: dmesg is not available" >&2
	exit 0
}

echo "gts9-kmsg-console: mirroring /dev/kmsg to $DEV"

# Restart the reader whenever the gadget disappears (cable pulled, host closes
# the port, gadget re-bound).  A write error to a tty is not fatal here: the
# loop just reopens it, and the kernel ring keeps the messages that were
# missed only for as long as the buffer holds them, which is why the reader is
# kept as close to /dev/kmsg as possible.
while :; do
	if [ ! -w "$DEV" ]; then
		sleep 2
		continue
	fi
	# reltime keeps the kernel's monotonic stamp: it is what lines the mirror
	# up with the tablet's own dmesg.  -x adds facility/level decoration.
	dmesg --follow --time-format reltime -x 2>/dev/null |
		while IFS= read -r line; do
			printf 'K %s\n' "$line" >"$DEV" 2>/dev/null || break
		done
	sleep 1
done
