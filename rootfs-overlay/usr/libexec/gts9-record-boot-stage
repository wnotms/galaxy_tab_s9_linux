#!/bin/sh
set -eu

stage=${1:?usage: gts9-record-boot-stage STAGE [FAILURE]}
failure=${2:-none}
record=/var/log/gts9-last-boot-stage

[ -f "$record" ] || exit 0

tmp="${record}.tmp.$$"
{
	cat "$record"
	printf 'GTS9_BOOT_STAGE=%s\n' "$stage"
	printf 'stage_uptime_seconds=%s\n' "$(cut -d' ' -f1 /proc/uptime 2>/dev/null || echo unknown)"
	printf 'stage_timestamp=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unknown)"
	printf 'stage_boot_id=%s\n' "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)"
	if [ "$failure" != none ]; then
		printf 'GTS9_BOOT_FAIL=%s\n' "$failure"
	fi
} > "$tmp"

chmod 0644 "$tmp"
mv -f "$tmp" "$record"
sync
