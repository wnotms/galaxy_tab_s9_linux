#!/bin/sh
# X710 USB debug link: the NCM network that ssh is reached over.
#
# This gadget has no serial port at all.  Getting here took three steps, and the
# order matters because each one exposed the next:
#
#   1. The serial *consoles* were removed.  acm.usb1 was the kernel printk console
#      and acm.usb0 carried an autologin root shell.  Console writes to a gadget
#      port block in n_tty_write() once its 8 KiB buffer fills with nobody
#      draining the host side, which stalled the boot; and the autologin shell
#      held the cgroup open so systemd waited out TimeoutStopSec on every
#      shutdown.  See docs/BOOT_CONSOLE_BLOCK.md and docs/SHUTDOWN_DELAY.md.
#
#   2. acm.usb1 was removed, because its only purpose was to be the port printk
#      registered on.  That left acm.usb0 as one plain serial port - not a
#      console, no getty - as a wired endpoint that did not depend on the network
#      function binding.
#
#   3. acm.usb0 is removed too (2026-09-26, owner's decision).  Measured before
#      removing it: nothing on the tablet held it open, nothing wrote to it, the
#      kernel log did not come out of it, and it was reachable only if somebody
#      opened a terminal on the host and started a reader on the tablet.  The
#      login is now the ssh key written into the rootfs at install time
#      (scripts/install-debian-rootfs.sh --ssh-key), which needs no channel on
#      the device at all.
#
# So the gadget is exactly one function: NCM.  The kernel is built without
# CONFIG_USB_CONFIGFS_ACM and CONFIG_USB_CONFIGFS_SERIAL, so no configfs
# "acm.usb0" can be created even by hand - the capability is gone, not just
# unused.  (CONFIG_USB_ACM, the *host*-side cdc_acm driver, is a different symbol
# and stays: it is what lets the tablet talk to a USB-serial adapter.)
#
# Why NCM rather than RNDIS or ECM: Windows binds its own in-box NCM driver, so
# no INF and no administrator rights are needed, and it is the fastest of the
# three.  Measured 31.8 MB/s for ssh over this link.
#
# The unit and helper keep the historical name "usb-acm" because the boot-stage
# history (`usb-acm-ready`), the test records and the documentation all refer to
# it; renaming would invalidate that audit trail for no functional gain.  Read the
# name as a label, not as a description of what is created.
#
# No mass storage, RNDIS, MTP or adb FUNCTION, and no block device is touched:
# the gadget must never be able to disturb the root filesystem it runs from, and
# the ADB function is not used because it would need a second gadget.
#
# Every wait is bounded.  A failure exits non-zero so `systemctl --failed`
# shows it, but nothing here reboots, panics or blocks the boot targets; the
# panel/tty1 path and the rest of Debian keep running.

set -u

# The defaults are the real paths; the GTS9_USB_* overrides exist so the host
# tests can drive the whole sequence against a temporary configfs-shaped tree.
CONFIGFS=${GTS9_USB_CONFIGFS:-/sys/kernel/config}
GADGET=${GTS9_USB_GADGET_DIR:-$CONFIGFS/usb_gadget/gts9}
UDC_DIR=${GTS9_USB_UDC_DIR:-/sys/class/udc}
UDC_WAIT_SECONDS=${GTS9_USB_UDC_WAIT_SECONDS:-15}
IFACE_WAIT_SECONDS=${GTS9_USB_IFACE_WAIT_SECONDS:-${GTS9_USB_TTY_WAIT_SECONDS:-5}}
STAGE_HELPER=${GTS9_STAGE_HELPER:-/usr/libexec/gts9-record-debian-stage}

record_stage() {
	if [ -x "$STAGE_HELPER" ]; then
		"$STAGE_HELPER" "$@" || true
	fi
}

fail() {
	echo "gts9-usb-acm: $*" >&2
	record_stage --failure usb-acm-failed usb-acm-failed
	exit 1
}

write_value() {
	# write_value PATH VALUE
	if ! echo "$2" > "$1" 2>/dev/null; then
		fail "cannot write $1"
	fi
}

if [ ! -d "$CONFIGFS/usb_gadget" ]; then
	mkdir -p "$CONFIGFS" 2>/dev/null || true
	mount -t configfs none "$CONFIGFS" 2>/dev/null || true
fi
if [ ! -d "$CONFIGFS/usb_gadget" ]; then
	fail 'configfs is not available'
fi

# --- the NCM network function: the ssh transport -----------------------------
#
# /etc/gts9-usb-net names the function and the address for the device side:
#
#	ncm 169.254.42.1/16
#
# It ships in the overlay rather than being created by hand, because since the
# serial consoles were removed it is the ONLY way into this tablet: a rootfs
# without it has no login at all.  install-debian-rootfs.sh installs the ssh key
# alongside it.
#
# The address is in 169.254.0.0/16 because Windows gives its own adapter an APIPA
# address in that range by itself, so the host needs no static IPv4 configuration
# and no elevation, and WSL2 reaches the tablet through the Windows host.
#
# The function goes into THIS gadget rather than a second one: a UDC binds one
# gadget at a time, so a separate gadget - which is what Debian's adbd package
# creates - cannot bind while this one owns the controller.
NET_CONF=${GTS9_USB_NET_CONF:-/etc/gts9-usb-net}
NET_IFACE=${GTS9_USB_NET_IFACE:-usb0}
net_kind=""
net_addr=""

read_net_conf() {
	[ -r "$NET_CONF" ] || return 0
	# Skip blank lines and '#' comments.  The file ships in the overlay, so it
	# carries a header explaining the format and the address choice; a plain
	# `read < file` would take the first comment line as the function name and
	# fail the whole file as unknown.
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
		'' | '#'*) continue ;;
		esac
		# shellcheck disable=SC2086
		set -- $line
		net_kind=${1:-}
		net_addr=${2:-}
		break
	done <"$NET_CONF"
	case "$net_kind" in
	"") return 0 ;;
	ncm | ecm) ;;
	*)
		echo "gts9-usb-acm: unknown network function '$net_kind' in $NET_CONF" >&2
		net_kind=""
		net_addr=""
		;;
	esac
}

net_drop() {
	[ -n "$net_kind" ] || return 0
	rm -f "$GADGET/configs/c.1/$net_kind.usb0" 2>/dev/null || true
	rmdir "$GADGET/functions/$net_kind.usb0" 2>/dev/null || true
	echo "gts9-usb-acm: dropped $net_kind.usb0" >&2
	net_kind=""
}

setup_network() {
	[ -n "$net_kind" ] || return 0
	if [ ! -d "$GADGET/functions/$net_kind.usb0" ]; then
		if ! mkdir -p "$GADGET/functions/$net_kind.usb0" 2>/dev/null; then
			echo "gts9-usb-acm: no $net_kind function in this kernel; want CONFIG_USB_CONFIGFS_${net_kind}" >&2
			net_kind=""
			return 0
		fi
	fi
	if [ ! -e "$GADGET/configs/c.1/$net_kind.usb0" ]; then
		if ! ln -s "$GADGET/functions/$net_kind.usb0" "$GADGET/configs/c.1/$net_kind.usb0" 2>/dev/null; then
			net_drop
			return 0
		fi
	fi
	echo "gts9-usb-acm: $net_kind.usb0 linked into the configuration"
}

configure_network() {
	[ -n "$net_kind" ] || return 0
	waited=0
	while [ "$waited" -lt "$IFACE_WAIT_SECONDS" ] && [ ! -d "/sys/class/net/$NET_IFACE" ]; do
		sleep 1
		waited=$((waited + 1))
	done
	if [ ! -d "/sys/class/net/$NET_IFACE" ]; then
		echo "gts9-usb-acm: $NET_IFACE did not appear after ${IFACE_WAIT_SECONDS}s" >&2
		return 0
	fi
	if [ -n "$net_addr" ]; then
		ip link set "$NET_IFACE" up 2>/dev/null || true
		ip addr replace "$net_addr" dev "$NET_IFACE" 2>/dev/null ||
			echo "gts9-usb-acm: could not put $net_addr on $NET_IFACE" >&2
	fi
	echo "gts9-usb-acm: $NET_IFACE up with $(ip -4 -o addr show dev "$NET_IFACE" 2>/dev/null | awk '{print $4}')"
}

# retire_serial_ports - remove serial functions from a gadget an older install
# built.
#
# An upgraded rootfs keeps the gadget the previous install built, and that gadget
# has acm.usb0 (and possibly acm.usb1) in its configuration.  configfs has no way
# to change a bound gadget's function set in place, so the whole gadget is torn
# down and rebuilt without them.  This runs before the "already bound" fast path
# below, so the migration happens exactly once and needs no reboot.
#
# It is deliberately narrow: it only acts when a serial function is actually
# linked into the configuration, and it only ever removes those functions.
#
# Note for anyone reading this with grep: the two names below are the ONLY places
# in this file where a serial function name appears, and both of them REMOVE one.
# Nothing here creates a serial function - that is the whole point of the change.
# tests/test_debian_usb_acm.py checks exactly that distinction rather than
# forbidding the string.
retire_serial_ports() {
	retired=""
	for fn in acm.usb0 acm.usb1; do
		[ -e "$GADGET/configs/c.1/$fn" ] && retired="$retired $fn"
		[ -d "$GADGET/functions/$fn" ] && retired="$retired $fn"
	done
	[ -n "$retired" ] || return 0

	echo "gts9-usb-acm: removing retired serial port(s):$retired"

	# Unbind first: configfs refuses to remove a function from a live gadget.
	echo "" > "$GADGET/UDC" 2>/dev/null || true

	for fn in acm.usb0 acm.usb1; do
		rm -f "$GADGET/configs/c.1/$fn" 2>/dev/null || true
		rmdir "$GADGET/functions/$fn" 2>/dev/null || true
	done

	# Everything else is dropped too, so the normal path below rebuilds a clean
	# gadget.  Dropping the network function in particular means the rebuild
	# re-creates it, which is what makes the link come back.
	if [ -n "$net_kind" ]; then
		rm -f "$GADGET/configs/c.1/$net_kind.usb0" 2>/dev/null || true
		rmdir "$GADGET/functions/$net_kind.usb0" 2>/dev/null || true
	fi
	# Any other function left in the configuration would keep the gadget valid
	# but wrong, so clear the configuration links outright.
	for link in "$GADGET/configs/c.1"/*; do
		[ -L "$link" ] || continue
		rm -f "$link" 2>/dev/null || true
	done
	for dir in "$GADGET/functions"/*; do
		[ -d "$dir" ] || continue
		rmdir "$dir" 2>/dev/null || true
	done

	# The UDC needs a moment to notice the unbind before it accepts the new
	# gadget; without this the rebind below can fail with EBUSY.
	waited=0
	while [ "$waited" -lt "$IFACE_WAIT_SECONDS" ] && [ -n "$(cat "$GADGET/UDC" 2>/dev/null)" ]; do
		sleep 1
		waited=$((waited + 1))
	done
	return 0
}

read_net_conf
retire_serial_ports

# A gadget left over from an earlier userspace and still bound already provides
# the link this service exists for; do not tear it down and rebuild it.
# `functions/` being non-empty is the test, not a specific function name: after
# retire_serial_ports the only thing that can be there is the network function.
if [ -d "$GADGET" ] && [ -n "$(ls -A "$GADGET/functions" 2>/dev/null)" ]; then
	bound_udc=$(cat "$GADGET/UDC" 2>/dev/null || true)
	if [ -n "$bound_udc" ]; then
		echo "gts9-usb-acm: gadget already bound to $bound_udc"
		configure_network
		record_stage usb-acm-ready
		exit 0
	fi
fi

mkdir -p "$GADGET" 2>/dev/null || fail "cannot create $GADGET"

mkdir -p "$GADGET/strings/0x409" 2>/dev/null || fail 'cannot create gadget strings'
mkdir -p "$GADGET/configs/c.1/strings/0x409" 2>/dev/null || fail 'cannot create the gadget configuration'

write_value "$GADGET/idVendor" 0x0525
write_value "$GADGET/idProduct" 0xa4a7
write_value "$GADGET/bcdDevice" 0x0100
write_value "$GADGET/bcdUSB" 0x0200
write_value "$GADGET/strings/0x409/manufacturer" Samsung
write_value "$GADGET/strings/0x409/product" 'GTS9 mainline debug link'
write_value "$GADGET/strings/0x409/serialnumber" gts9wifi-0001
write_value "$GADGET/configs/c.1/strings/0x409/configuration" debug
write_value "$GADGET/configs/c.1/MaxPower" 250

# The only function.  No serial port is created, deliberately and permanently.
setup_network
if [ -z "$net_kind" ]; then
	fail "no network function: check $NET_CONF and CONFIG_USB_CONFIGFS_NCM (without it this gadget provides no way into the tablet)"
fi

waited=0
while [ "$waited" -lt "$UDC_WAIT_SECONDS" ] && \
      [ -z "$(ls -A "$UDC_DIR" 2>/dev/null)" ]; do
	sleep 1
	waited=$((waited + 1))
done
udc=$(ls "$UDC_DIR" 2>/dev/null | head -n 1)
if [ -z "$udc" ]; then
	fail "no USB device controller after ${UDC_WAIT_SECONDS}s"
fi

if ! echo "$udc" > "$GADGET/UDC" 2>/dev/null; then
	fail "cannot bind the gadget to $udc"
fi
echo "gts9-usb-acm: bound to $udc"

configure_network

record_stage usb-acm-ready
exit 0
