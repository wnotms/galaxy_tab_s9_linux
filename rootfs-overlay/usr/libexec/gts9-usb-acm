#!/bin/sh
# X710 USB debug link: the ECM/NCM network that ssh is reached over.
#
# History, because it explains the shape of this file.  Until 2026-09-26 this
# gadget was the *console*: acm.usb0 carried an autologin root shell and acm.usb1
# carried the kernel printk console, split across two interfaces because a gadget
# serial console takes its port's IN endpoint for printk (gs_console_connect() ->
# cons->req), so a port that is both the kernel console and a getty can only ever
# send kernel messages.
#
# Both serial consoles were then removed - they are the measured cause of the
# boot stall (docs/BOOT_CONSOLE_BLOCK.md: a userspace write() to /dev/console
# blocks in n_tty_write() while nothing drains the gadget port) and of the ~90 s
# poweroff (docs/SHUTDOWN_DELAY.md: agetty --autologin spawns a login shell it
# does not reap, so systemd waits out TimeoutStopSec).  With
# CONFIG_U_SERIAL_CONSOLE unset the kernel no longer offers the configfs
# `console` attribute at all, so the split_consoles() dance below is now a no-op
# that is kept only so this script still runs unchanged against an older kernel.
#
# What is left is the transport: acm.usb0/acm.usb1 still exist so the host sees
# the same two COM ports (an interface renumbering would move the COM numbers),
# but nothing logs in on them.  The interactive channel is ssh over the NCM/ECM
# network function, which /etc/gts9-usb-net asks for; that file ships in the
# overlay because it is what makes a fresh rootfs reachable at all.
#
# No mass storage, RNDIS, MTP or adb FUNCTION, and no block device is touched:
# the gadget must never be able to disturb the root filesystem it runs from, and
# the ADB function is not used because it would need a second gadget.
#
# Every wait is bounded.  A failure exits non-zero so `systemctl --failed`
# shows it, but nothing here reboots, panics or blocks the boot targets; the
# panel/tty1 path and the rest of Debian keep running.

set -u

# The defaults are the real paths; the GTS9_USB_* overrides exist so the host
# tests can drive the whole sequence against a temporary configfs-shaped tree.
CONFIGFS=${GTS9_USB_CONFIGFS:-/sys/kernel/config}
GADGET=${GTS9_USB_GADGET_DIR:-$CONFIGFS/usb_gadget/gts9}
UDC_DIR=${GTS9_USB_UDC_DIR:-/sys/class/udc}
TTY_DEVICE=${GTS9_USB_TTY:-/dev/ttyGS0}
UDC_WAIT_SECONDS=${GTS9_USB_UDC_WAIT_SECONDS:-15}
TTY_WAIT_SECONDS=${GTS9_USB_TTY_WAIT_SECONDS:-5}
STAGE_HELPER=${GTS9_STAGE_HELPER:-/usr/libexec/gts9-record-debian-stage}

record_stage() {
	if [ -x "$STAGE_HELPER" ]; then
		"$STAGE_HELPER" "$@" || true
	fi
}

fail() {
	echo "gts9-usb-acm: $*" >&2
	record_stage --failure usb-acm-failed usb-acm-failed
	exit 1
}

write_value() {
	# write_value PATH VALUE
	if ! echo "$2" > "$1" 2>/dev/null; then
		fail "cannot write $1"
	fi
}

if [ ! -d "$CONFIGFS/usb_gadget" ]; then
	mkdir -p "$CONFIGFS" 2>/dev/null || true
	mount -t configfs none "$CONFIGFS" 2>/dev/null || true
fi
if [ ! -d "$CONFIGFS/usb_gadget" ]; then
	fail 'configfs is not available'
fi

# split_consoles - keep the gadget ports out of printk.
#
# This was the console handover: u_serial gives the *first* allocated port a
# console automatically (gserial_alloc_line() -> gs_console_init()), so acm.usb0
# used to start out owning its IN endpoint for the kernel log and the login shell
# could not send a byte.  The configfs "console" attribute was the switch - 0 on
# the shell port, 1 on the port named by console=ttyGS1.
#
# With CONFIG_U_SERIAL_CONSOLE unset the attribute does not exist at all and no
# ttyGS port can ever become a console, which is the state this port now builds
# deliberately: `console=ttyGS1` is gone from the command line and printk must
# never reach the gadget again (docs/BOOT_CONSOLE_BLOCK.md).
#
# The function is kept, and still forces 0 rather than 1, so that running this
# script against an older kernel - a recovery image, or a rollback - leaves the
# gadget with no console on it either.  Every write stays best-effort.
split_consoles() {
	if [ -e "$GADGET/functions/acm.usb0/console" ]; then
		echo 0 > "$GADGET/functions/acm.usb0/console" 2>/dev/null &&
			echo "gts9-usb-acm: acm.usb0 is not a console" ||
			echo "gts9-usb-acm: could not clear the acm.usb0 console" >&2
	fi
	if [ -e "$GADGET/functions/acm.usb1/console" ]; then
		echo 0 > "$GADGET/functions/acm.usb1/console" 2>/dev/null &&
			echo "gts9-usb-acm: acm.usb1 is not a console (printk must not reach the gadget)" ||
			echo "gts9-usb-acm: could not clear the acm.usb1 console" >&2
	fi
}

# --- optional USB network function -------------------------------------------
#
# --- USB network function: the ssh transport --------------------------------
#
# Off unless /etc/gts9-usb-net exists, in which case the file names the function
# and the address for the device side:
#
#	ncm 169.254.42.1/16
#
# Why a network and not a console: ssh over this link measures 31.8 MB/s against
# the serial console's ~3 KB/s.  Measured 2026-09-25, 131072 bytes took the same
# 40 s at a host baud of 115200 and at 921600 - the line coding is nominal,
# because the COM ports are USB CDC-ACM and the bytes really travel in USB bulk
# transfers, so raising the baud cannot help.
#
# Since 2026-09-26 this is not merely the faster option, it is the ONLY one:
# both serial debug consoles were removed (docs/BOOT_CONSOLE_BLOCK.md,
# docs/SHUTDOWN_DELAY.md) and /etc/gts9-usb-net now ships in the overlay rather
# than being created by hand, because a rootfs without it would have no way in
# at all.
#
# The function goes into THIS gadget rather than a second one: a UDC binds one
# gadget at a time, so a separate gadget - which is what Debian's adbd package
# creates - cannot bind while this one owns the controller.  Every step stays
# best-effort: on any failure the function is dropped and the gadget binds with
# its ACM ports alone, so a bad line in the file cannot cost the USB link.
NET_CONF=${GTS9_USB_NET_CONF:-/etc/gts9-usb-net}
NET_IFACE=${GTS9_USB_NET_IFACE:-usb0}
net_kind=""
net_addr=""

read_net_conf() {
	[ -r "$NET_CONF" ] || return 0
	# Skip blank lines and '#' comments.  The file ships in the overlay, so it
	# carries a header explaining the format and the address choice; a plain
	# `read < file` would take the first comment line as the function name and
	# fail the whole file as unknown.
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in
		'' | '#'*) continue ;;
		esac
		# shellcheck disable=SC2086
		set -- $line
		net_kind=${1:-}
		net_addr=${2:-}
		break
	done <"$NET_CONF"
	case "$net_kind" in
	"") return 0 ;;
	ncm | ecm) ;;
	*)
		echo "gts9-usb-acm: unknown network function '$net_kind' in $NET_CONF" >&2
		net_kind=""
		net_addr=""
		;;
	esac
}

net_drop() {
	[ -n "$net_kind" ] || return 0
	rm -f "$GADGET/configs/c.1/$net_kind.usb0" 2>/dev/null || true
	rmdir "$GADGET/functions/$net_kind.usb0" 2>/dev/null || true
	echo "gts9-usb-acm: dropped $net_kind.usb0; the ACM console is unaffected" >&2
	net_kind=""
}

setup_network() {
	[ -n "$net_kind" ] || return 0
	if [ ! -d "$GADGET/functions/$net_kind.usb0" ]; then
		if ! mkdir -p "$GADGET/functions/$net_kind.usb0" 2>/dev/null; then
			echo "gts9-usb-acm: no $net_kind function in this kernel; want CONFIG_USB_CONFIGFS_${net_kind}" >&2
			net_kind=""
			return 0
		fi
	fi
	if [ ! -e "$GADGET/configs/c.1/$net_kind.usb0" ]; then
		if ! ln -s "$GADGET/functions/$net_kind.usb0" "$GADGET/configs/c.1/$net_kind.usb0" 2>/dev/null; then
			net_drop
			return 0
		fi
	fi
	echo "gts9-usb-acm: $net_kind.usb0 linked into the configuration"
}

configure_network() {
	[ -n "$net_kind" ] || return 0
	waited=0
	while [ "$waited" -lt "$TTY_WAIT_SECONDS" ] && [ ! -d "/sys/class/net/$NET_IFACE" ]; do
		sleep 1
		waited=$((waited + 1))
	done
	if [ ! -d "/sys/class/net/$NET_IFACE" ]; then
		echo "gts9-usb-acm: $NET_IFACE did not appear after ${TTY_WAIT_SECONDS}s" >&2
		return 0
	fi
	if [ -n "$net_addr" ]; then
		ip link set "$NET_IFACE" up 2>/dev/null || true
		ip addr replace "$net_addr" dev "$NET_IFACE" 2>/dev/null ||
			echo "gts9-usb-acm: could not put $net_addr on $NET_IFACE" >&2
	fi
	echo "gts9-usb-acm: $NET_IFACE up with $(ip -4 -o addr show dev "$NET_IFACE" 2>/dev/null | awk '{print $4}')"
}

read_net_conf

# A gadget left over from an earlier userspace and still bound is already the
# console this service exists to provide; do not tear it down and rebuild it.
if [ -d "$GADGET" ] && [ -d "$GADGET/functions/acm.usb0" ]; then
	bound_udc=$(cat "$GADGET/UDC" 2>/dev/null || true)
	if [ -n "$bound_udc" ]; then
		echo "gts9-usb-acm: gadget already bound to $bound_udc"
		split_consoles
		configure_network
		record_stage usb-acm-ready
		exit 0
	fi
fi

mkdir -p "$GADGET" 2>/dev/null || fail "cannot create $GADGET"

# Same verified identifiers as the initramfs gadget: Windows already maps
# these to the COM port the bring-up logs were captured from.
mkdir -p "$GADGET/strings/0x409" 2>/dev/null || fail 'cannot create gadget strings'
mkdir -p "$GADGET/configs/c.1/strings/0x409" 2>/dev/null || fail 'cannot create the gadget configuration'

write_value "$GADGET/idVendor" 0x0525
write_value "$GADGET/idProduct" 0xa4a7
write_value "$GADGET/bcdDevice" 0x0100
write_value "$GADGET/bcdUSB" 0x0200
write_value "$GADGET/strings/0x409/manufacturer" Samsung
write_value "$GADGET/strings/0x409/product" 'GTS9 mainline Debian debug console'
write_value "$GADGET/strings/0x409/serialnumber" gts9wifi-0001
write_value "$GADGET/configs/c.1/strings/0x409/configuration" bringup
write_value "$GADGET/configs/c.1/MaxPower" 250

mkdir -p "$GADGET/functions/acm.usb0" 2>/dev/null || fail 'cannot create the ACM function'
if [ ! -e "$GADGET/configs/c.1/acm.usb0" ]; then
	ln -s "$GADGET/functions/acm.usb0" "$GADGET/configs/c.1/acm.usb0" 2>/dev/null || \
		fail 'cannot link the ACM function into the configuration'
fi

# Second ACM port: the kernel console.  Created after acm.usb0 so u_serial hands
# it line 1 (gserial_alloc_line() picks the first free port).
mkdir -p "$GADGET/functions/acm.usb1" 2>/dev/null || fail 'cannot create the console ACM function'
if [ ! -e "$GADGET/configs/c.1/acm.usb1" ]; then
	ln -s "$GADGET/functions/acm.usb1" "$GADGET/configs/c.1/acm.usb1" 2>/dev/null || \
		fail 'cannot link the console ACM function into the configuration'
fi

setup_network

waited=0
while [ "$waited" -lt "$UDC_WAIT_SECONDS" ] && \
      [ -z "$(ls -A "$UDC_DIR" 2>/dev/null)" ]; do
	sleep 1
	waited=$((waited + 1))
done
udc=$(ls "$UDC_DIR" 2>/dev/null | head -n 1)
if [ -z "$udc" ]; then
	fail "no USB device controller after ${UDC_WAIT_SECONDS}s"
fi

if ! echo "$udc" > "$GADGET/UDC" 2>/dev/null; then
	# A bind failure must never cost the console: drop the optional network
	# function and retry once with the ACM ports alone.
	if [ -n "$net_kind" ]; then
		net_drop
		echo "$udc" > "$GADGET/UDC" 2>/dev/null || fail "cannot bind the gadget to $udc"
	else
		fail "cannot bind the gadget to $udc"
	fi
fi

waited=0
while [ "$waited" -lt "$TTY_WAIT_SECONDS" ] && [ ! -c "$TTY_DEVICE" ]; do
	sleep 1
	waited=$((waited + 1))
done
if [ -c "$TTY_DEVICE" ]; then
	echo "gts9-usb-acm: bound to $udc; $TTY_DEVICE is ready"
else
	echo "gts9-usb-acm: bound to $udc; $TTY_DEVICE has not appeared yet" >&2
fi

split_consoles
configure_network

record_stage usb-acm-ready
exit 0
