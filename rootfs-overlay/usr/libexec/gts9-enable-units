#!/bin/sh
# Create the systemd enablement symlinks for the gts9 units of a Debian root.
#
# Why this exists instead of shipping the symlinks in the overlay tarball:
# TWRP's busybox tar refuses to replace a symlink whose stored target is
# absolute and outside the extraction root.  It prints
#
#	... not under '/mnt/debian'
#
# and exits non-zero, so an overlay that carried the enablement links could be
# extracted once (on a fresh rootfs) but never updated afterwards.  The tarball
# therefore carries regular files only, and this helper - which runs the same
# way on the host and inside TWRP - creates the links.
#
# Usage: gts9-enable-units [TARGET_ROOT]      (default /)
#
# It is idempotent, only ever touches links named after gts9 units (plus the
# ttyGS0 getty instance) and never removes anything else.  systemctl is not
# required; the links are created from each unit's own WantedBy= line, so the
# result is what `systemctl enable` would produce.

set -u

root=${1:-/}
unit_dir=$root/usr/lib/systemd/system
etc_dir=$root/etc/systemd/system

if [ ! -d "$unit_dir" ]; then
	echo "gts9-enable-units: $unit_dir does not exist" >&2
	exit 1
fi

created=0

link_unit() {
	# link_unit WANTS LINK_NAME [TARGET_NAME]
	# TARGET_NAME defaults to LINK_NAME; a template instance links to its
	# template file (serial-getty@ttyGS0.service -> serial-getty@.service).
	wants=$1
	name=$2
	target=${3:-$2}
	case "$wants" in
	'' | */* | *..*) return 0 ;;
	esac
	dir=$etc_dir/${wants}.wants
	mkdir -p "$dir" 2>/dev/null || return 0
	# rm the link first: ln -sf without -n may dereference an existing link
	# in some implementations, and this must never touch the target file.
	rm -f "$dir/$name" 2>/dev/null || true
	# Relative so the deployed tree stays self-contained.
	ln -s "../../../../usr/lib/systemd/system/$target" "$dir/$name" 2>/dev/null || return 0
	created=$((created + 1))
}

for unit in "$unit_dir"/gts9-*.service; do
	[ -f "$unit" ] || continue
	name=${unit##*/}
	for wants in $(sed -n 's/^WantedBy=//p' "$unit" 2>/dev/null); do
		link_unit "$wants" "$name"
	done
done

# --- serial debug getties: all removed 2026-09-26 ---------------------------
#
# The tablet is reached over ssh now (docs/FAST_DEBUG_CHANNEL.md) and every
# serial console is gone from the kernel command line, so no serial getty should
# ever run.  Three separate things have to be cleaned up, because an upgraded
# rootfs keeps whatever the previous install left behind.
#
# 1. The old generic serial-getty@ttyGS0 instance.  It is created by systemd from
#    the console= argument, it depends on dev-ttyGS0.device, and that device unit
#    times out when the gadget is created a moment later.  No console= argument
#    names ttyGS any more, so the generator no longer creates it - but a previous
#    install enabled it, so drop the link and mask the name for the same reason as
#    the two below.
rm -f "$etc_dir/getty.target.wants/serial-getty@ttyGS0.service" 2>/dev/null || true
if [ -d "$etc_dir" ]; then
	ln -sfn /dev/null "$etc_dir/serial-getty@ttyGS0.service" 2>/dev/null || true
fi

# 2. gts9-acm-getty.service, the autologin root shell this repository used to
#    ship for ttyGS0.  This is the 90 s poweroff: `agetty --autologin` spawns a
#    login shell that agetty does not reap on SIGTERM, so the unit's cgroup stays
#    populated and systemd waits out TimeoutStopSec before escalating.  The unit
#    file is gone from the overlay, so the ENABLE LINK must go too - a dangling
#    link in multi-user.target.wants is a boot-time failure, not a no-op.
rm -f "$etc_dir/multi-user.target.wants/gts9-acm-getty.service" 2>/dev/null || true
#    An operator may also have a copy in /etc/systemd/system/, and /etc wins over
#    /usr/lib - this repository's own notes record the two copies having diverged
#    once, so a stale one is an observed condition rather than a hypothetical.
#    Mask the name outright with `ln -sfn`: it replaces whatever is there
#    (including a regular file) with /dev/null, which is what `systemctl mask`
#    does and is the only thing that reliably stops the unit starting.  A
#    guard like `[ ! -e ... ]` would leave the stale copy in charge.
if [ -d "$etc_dir" ]; then
	ln -sfn /dev/null "$etc_dir/gts9-acm-getty.service" 2>/dev/null || true
fi

# 3. ttyMSM0.  The SoC UART is no longer a console either; with no console=
#    argument naming it, systemd's getty-generator no longer creates the unit,
#    but a previous install enabled it and it made boot wait for
#    dev-ttyMSM0.device, which timed out on 2026-09-24.  Drop the link and mask
#    the name for the same reason as above.
rm -f "$etc_dir/getty.target.wants/serial-getty@ttyMSM0.service" 2>/dev/null || true
if [ -d "$etc_dir" ]; then
	ln -sfn /dev/null "$etc_dir/serial-getty@ttyMSM0.service" 2>/dev/null || true
fi

# 4. The autologin drop-in for the ttyGS0 instance.
#    An even earlier install shipped
#    /etc/systemd/system/serial-getty@ttyGS0.service.d/autologin.conf, whose whole
#    content is an `agetty --autologin root` override.  It was found still on the
#    tablet on 2026-09-26, inert only because the instance it decorates is masked
#    two lines above - so it is a live configuration file waiting for anyone who
#    unmasks the name, which is exactly how this class of leftover comes back.
#    Remove it, and its directory if that leaves it empty.
rm -f "$etc_dir/serial-getty@ttyGS0.service.d/autologin.conf" 2>/dev/null || true
rmdir "$etc_dir/serial-getty@ttyGS0.service.d" 2>/dev/null || true

# tty1 is deliberately untouched: it is the panel VT, the only console left, and
# the local getty on it is how the tablet is used without a cable.

echo "gts9-enable-units: $created link(s) in $etc_dir"
exit 0
