#!/bin/sh
# Provide the X710's own Bluetooth public address, which the controller cannot
# supply for itself.
#
# Why this exists
# ---------------
# The WCN6855 on this board reports a placeholder public address and the upstream
# NVM (qca/wcnhpnv21g.bin) contains the *same* placeholder, so btqca cannot tell
# a real address from a default one:
#
#   drivers/bluetooth/btqca.c:702  qca_check_bdaddr()
#       if (!bacmp(&bda->bdaddr, &config->bdaddr))
#               hci_set_quirk(hdev, HCI_QUIRK_USE_BDADDR_PROPERTY);
#
# With that quirk set and no address supplied, hci_sync deliberately leaves the
# controller unconfigured and closes it:
#
#   net/bluetooth/hci_sync.c:5501-5504
#       if (hci_dev_test_flag(hdev, HCI_RFKILLED) ||
#           hci_dev_test_flag(hdev, HCI_UNCONFIGURED) || ...)
#               hci_dev_close_sync(hdev);
#
# so the controller sits in "DOWN RAW" and BlueZ sees no usable index at all.
# The kernel can only take this address from the Device Tree
# (hci_dev_get_bd_addr_from_property(), net/bluetooth/hci_sync.c:3612), and the
# address is unique per unit - it is provisioning data, not a board constant - so
# a DTS property would be wrong for every tablet but one. The kernel offers the
# standard management interface instead, and BlueZ exposes it as
# `btmgmt public-addr`; that is what this helper uses.
#
# Root cause evidence: reference/boot-tests/test-218-bluetooth-firmware/
#
# The address comes from Samsung's own provisioning file, read-only:
#   /efs/bluetooth/bt_addr      17 bytes of ASCII "XX:XX:XX:XX:XX:XX"
# efs is mounted read-only with noload and unmounted again in every path. This
# helper never writes to efs, persist or any other Android partition.
#
# Deliberately harmless when it cannot help: every step is bounded, every failure
# is recorded and then ignored, and the exit status is always 0. It never reboots,
# never writes an address it did not read from the device, and never invents one.

set -u

EFS_DEVICE=${GTS9_BT_EFS_DEVICE:-/dev/disk/by-partlabel/efs}
EFS_MOUNT=${GTS9_BT_EFS_MOUNT:-/run/gts9-bt-efs}
BT_ADDR_FILE=${GTS9_BT_ADDR_FILE:-$EFS_MOUNT/bluetooth/bt_addr}
BTMGM=${GTS9_BTMGMT:-/usr/bin/btmgmt}
KMSG=${GTS9_BT_KMSG:-/dev/kmsg}
STAGE_HELPER=${GTS9_BT_STAGE_HELPER:-/usr/libexec/gts9-record-debian-stage}
ADDR_WAIT_SECONDS=${GTS9_BT_ADDR_WAIT_SECONDS:-10}

log() {
	printf 'gts9-bt-addr: %s\n' "$*"
	printf 'gts9-bt-addr: %s\n' "$*" > "$KMSG" 2>/dev/null || true
}

stage() {
	[ -x "$STAGE_HELPER" ] || return 0
	"$STAGE_HELPER" "$1" 2>/dev/null || true
}

cleanup() {
	umount "$EFS_MOUNT" 2>/dev/null || true
	rmdir "$EFS_MOUNT" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# 1. Read this unit's address from Samsung's provisioning file.
# ---------------------------------------------------------------------------
addr=
waited=0
while [ "$waited" -lt "$ADDR_WAIT_SECONDS" ]; do
	[ -b "$EFS_DEVICE" ] && break
	sleep 1
	waited=$((waited + 1))
done

if [ ! -b "$EFS_DEVICE" ]; then
	log "no $EFS_DEVICE after ${ADDR_WAIT_SECONDS}s; the controller will stay unconfigured"
	stage bluetooth-address-unavailable
	exit 0
fi

mkdir -p "$EFS_MOUNT" 2>/dev/null || true
# ro,noload matters: a plain `ro` mount of a filesystem needing recovery prints
# "write access will be enabled during recovery" and replays the journal, which
# writes to the owner's efs partition. noload skips the journal entirely.
if mount -t ext4 -o ro,noload "$EFS_DEVICE" "$EFS_MOUNT" 2>/dev/null; then
	if [ -r "$BT_ADDR_FILE" ]; then
		addr=$(tr -d ' \t\r\n' < "$BT_ADDR_FILE" 2>/dev/null | head -c 32)
	fi
	cleanup
else
	log "could not mount efs read-only; leaving the controller alone"
	stage bluetooth-address-unavailable
	exit 0
fi

# Validate strictly: six hex pairs. A malformed or empty file must never be
# passed on, or we would be writing an address we did not verify.
if ! printf '%s' "$addr" | grep -qiE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$'; then
	log "bt_addr missing or malformed (${addr:-empty}); the controller will stay unconfigured"
	stage bluetooth-address-unavailable
	exit 0
fi

# An all-zero address is explicitly rejected by the kernel as "not provisioned".
case "$addr" in
00:00:00:00:00:00|00:00:00:00:00:00:00) log "bt_addr is all zero; refusing to use it"
	stage bluetooth-address-unavailable
	exit 0
	;;
esac

# ---------------------------------------------------------------------------
# 2. Wait for the controller to register, then give it the address.
# ---------------------------------------------------------------------------
# hci_qca registers hci0 from the DT serdev during boot, and the firmware
# download takes a second or two. Measured on the tablet, the two readiness
# points are NOT the same instant:
#
#   hci0 present in /sys/class/bluetooth:  +0 s
#   btmgmt public-addr accepted:           +1 s   (controller still in HCI_SETUP)
#
# so a single attempt made as soon as the sysfs node exists fails with
# "Set Public Address for hci0 failed with status 0x11 (Invalid Index)". That is
# exactly what happened on a real cold boot. The node is therefore only a hint to
# start trying; the address is applied by retrying until the controller accepts
# it. This is not a sleep used to hide a fault - it is waiting for a documented
# prerequisite, and it is bounded and measured, so a genuine failure still shows
# up as a failure rather than as a longer boot.
waited=0
while [ "$waited" -lt "$ADDR_WAIT_SECONDS" ]; do
	[ -e /sys/class/bluetooth/hci0 ] && break
	sleep 1
	waited=$((waited + 1))
done

if [ ! -e /sys/class/bluetooth/hci0 ]; then
	log "no hci0 after ${ADDR_WAIT_SECONDS}s; nothing to configure"
	stage bluetooth-address-unavailable
	exit 0
fi

if [ ! -x "$BTMGM" ]; then
	log "$BTMGM not installed; cannot set the public address"
	stage bluetooth-address-unavailable
	exit 0
fi

# Every btmgmt call is wrapped in `timeout`, and stdin is fed from the shell
# builtin `:` rather than /dev/null. Both details were forced by measurement on
# the tablet, not chosen:
#
#   * `btmgmt ... </dev/null` HANGS. systemd gives a unit /dev/null on stdin, and
#     with it `btmgmt public-addr` never returned; the unit had to be killed by
#     TimeoutStartSec. Piped stdin (or a tty) works and returns in milliseconds.
#   * `btmgmt info` BLOCKS when it runs before bluetoothd has opened the
#     management socket, which is exactly the cold-boot case. So the address is
#     set first and the probe afterwards is best-effort.
#
# Neither is a workaround for a broken controller: the address is accepted in
# both forms, and the operation is idempotent.
run_btmgmt() { # run_btmgmt SECONDS ARGS...
	secs=$1
	shift
	: | timeout "$secs" "$BTMGM" "$@" 2>&1
}

# The controller's CURRENT address, read without needing bluetoothd and without
# going through the management interface. This is the ground truth for every
# decision below: the management replies are ambiguous (see the table further
# down) but the address itself is not. `hciconfig` is deprecated but it is the
# only reader available here - sysfs exposes no address attribute (checked:
# /sys/class/bluetooth/hci0/ has only device, power, reset, rfkill0, subsystem,
# uevent), and btmgmt needs the management socket.
read_ctrl_addr() {
	command -v hciconfig >/dev/null 2>&1 || return 1
	hciconfig hci0 2>/dev/null |
		sed -n 's/.*BD Address: *\([0-9A-Fa-f:]\{17\}\).*/\1/p' | head -1
}

# Wait, bounded, for the controller to report the address we just set. After a
# successful `public-addr` the re-initialisation is asynchronous: measured on the
# tablet, hciconfig still showed the OLD placeholder immediately afterwards.
wait_for_ctrl_addr() { # wait_for_ctrl_addr WANT SECONDS
	want=$1
	limit=$2
	n=0
	while [ "$n" -lt "$limit" ]; do
		[ "$(read_ctrl_addr)" = "$want" ] && return 0
		sleep 1
		n=$((n + 1))
	done
	return 1
}

# Already done? Leave it completely alone: no management call at all, so there is
# no chance of disturbing a controller that is working.
if [ "$(read_ctrl_addr)" = "$addr" ]; then
	log "controller already reports $addr; leaving it alone"
	stage bluetooth-address-present
	exit 0
fi

# Ask for the address. The three replies mean different things, and two of them
# are not failures - all three were measured on the tablet:
#
#   "Set Public Address ... complete"       accepted; the controller then
#                                           re-initialises asynchronously
#   "... failed with status 0x11 (Invalid   the controller is mid-transition and
#    Index)"                                not registered yet -> retry
#   "... failed with status 0x0b            already configured, so the request is
#    (Rejected)"                            refused -> not an error if the address
#                                           is in fact already what we want
#
# Because the last two are ambiguous from the message alone, the OUTCOME is
# decided by re-reading the address, never by the text.
out=
tries=0
while [ "$tries" -lt "$ADDR_WAIT_SECONDS" ]; do
	out=$(run_btmgmt 10 public-addr "$addr")
	case "$out" in
	*complete*) break ;;
	*"Invalid Index"* | *"Invalid index"*)
		tries=$((tries + 1))
		sleep 1
		;;
	*) break ;;
	esac
done

# Judge by the address, not by the reply.
if wait_for_ctrl_addr "$addr" "$ADDR_WAIT_SECONDS"; then
	if [ "$tries" -gt 0 ]; then
		log "set public address $addr after ${tries}s (controller was still registering)"
	else
		log "set public address $addr (from $BT_ADDR_FILE)"
	fi
	stage bluetooth-address-set
elif printf '%s' "$out" | grep -qiE 'complete|already|rejected|busy|in progress'; then
	# The controller refused or acknowledged but does not report the address yet.
	# Report what is actually on the controller rather than guessing.
	log "address request returned '$(printf '%s' "$out" | tr -d '\033' | sed 's/\[[0-9;]*m//g' | tr -s ' ' | head -c 120)', but the controller reports $(read_ctrl_addr)"
	stage bluetooth-address-unconfirmed
else
	log "could not set the public address: $(printf '%s' "$out" | tr -d '\033' | sed 's/\[[0-9;]*m//g' | tr -s ' ' | head -c 120)"
	stage bluetooth-address-failed
fi

exit 0
