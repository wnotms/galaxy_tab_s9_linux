#!/bin/sh
# X710 Pogo keyboard cold-boot recovery, run from Debian userspace.
#
# The keyboard's STM32 is powered from the tablet's Pogo rail, and the
# built-in driver probes at around 0.6 s - before the MCU is ready to answer.
# On this tablet that makes its 250 ms connect-line check read 0, so the
# driver concludes "confirmed detach", powers the rail off and reports
# DETACHED (test 178: no usable input device at boot).  Two things bring it
# back, and both are covered here:
#
#   * the driver's own hot-reconnect: when the connect line goes high later it
#     powers the rail, arms the IRQ and reads the MCU model (observed at 34 s
#     after boot in test 178);
#   * the driver's explicit rearm interface, which runs the full boot sequence
#     again:
#
#	echo hard > /sys/bus/i2c/devices/5-002a/rearm
#
# This service is therefore an observer with a bounded window: it watches the
# driver's state/connect attributes for up to GTS9_POGO_WINDOW_SECONDS, lets
# the driver's hot-reconnect win if it can, and only asks for a hard rearm
# when a keyboard is attached (connect=1) while the driver still reports
# DETACHED.  It is the same "userspace owns the sequencing, the driver owns
# the hardware" split as the panel recovery, it always exits 0, and it never
# blocks the boot.

set -u

POGO_SYSFS=${GTS9_POGO_SYSFS:-/sys/bus/i2c/devices/5-002a/rearm}
STAGE_HELPER=${GTS9_STAGE_HELPER:-/usr/libexec/gts9-record-debian-stage}
KMSG=${GTS9_POGO_KMSG:-/dev/kmsg}
WINDOW_SECONDS=${GTS9_POGO_WINDOW_SECONDS:-60}
POLL_SECONDS=${GTS9_POGO_POLL_SECONDS:-5}
REARM_WAIT_SECONDS=${GTS9_POGO_REARM_WAIT_SECONDS:-3}

report() {
	echo "gts9-pogo-recover: $*"
	if [ -w "$KMSG" ]; then
		printf 'gts9-pogo-recover: %s\n' "$*" > "$KMSG" 2>/dev/null || true
	fi
}

record_stage() {
	if [ -x "$STAGE_HELPER" ]; then
		"$STAGE_HELPER" "$@" || true
	fi
}

finish() {
	# finish STAGE MESSAGE [FAILURE]
	report "$2"
	if [ $# -ge 3 ] && [ -n "$3" ]; then
		record_stage --failure "$3" "$1"
	else
		record_stage "$1"
	fi
	exit 0
}

field() {
	# field NAME -> value from the rearm attribute, or an empty string
	sed -n "s/^$1=//p" "$POGO_SYSFS" 2>/dev/null | head -n 1
}

if [ ! -r "$POGO_SYSFS" ]; then
	finish pogo-absent 'the Pogo keyboard driver is not present'
fi

saw_connect=0
saw_not_ready=0
elapsed=0
while [ "$elapsed" -lt "$WINDOW_SECONDS" ]; do
	state=$(field state)
	connect=$(field connect)

	if [ "$state" = READY ]; then
		if [ "$saw_not_ready" = 1 ]; then
			finish pogo-recovered \
				"keyboard READY after the driver reconnected (connect=$connect)"
		fi
		finish pogo-ok "keyboard already READY (connect=$connect)"
	fi
	saw_not_ready=1

	if [ "$connect" = 1 ]; then
		saw_connect=1
		report "keyboard attached but the driver reports ${state:-?}; requesting a hard rearm"
		echo hard > "$POGO_SYSFS" 2>/dev/null || true
		waited=0
		while [ "$waited" -lt "$REARM_WAIT_SECONDS" ]; do
			sleep 1
			waited=$((waited + 1))
			if [ "$(field state)" = READY ]; then
				finish pogo-recovered \
					"keyboard READY after a hard rearm (connect=$(field connect))"
			fi
		done
		report "the hard rearm did not bring the keyboard up yet"
	fi

	sleep "$POLL_SECONDS"
	elapsed=$((elapsed + POLL_SECONDS))
done

if [ "$saw_connect" = 1 ]; then
	finish pogo-recovery-failed \
		"keyboard attached but still $(field state) after ${WINDOW_SECONDS}s" \
		pogo-recovery-failed
fi
finish pogo-absent \
	"no keyboard attached within ${WINDOW_SECONDS}s (connect=0)"
