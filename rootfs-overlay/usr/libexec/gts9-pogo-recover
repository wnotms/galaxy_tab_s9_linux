#!/bin/sh
# X710 Pogo keyboard cold-boot recovery, run from Debian userspace.
#
# The keyboard's STM32 is powered from the tablet's Pogo rail, and the
# built-in driver probes at around 0.6 s - before the MCU is ready to answer.
# On this tablet that makes the connect-line check read 0, so the driver
# concludes "confirmed detach", powers the rail off and reports DETACHED with
# no working input device.  The same hardware recovers completely when the
# driver's own rearm interface is used later:
#
#	echo hard > /sys/bus/i2c/devices/5-002a/rearm
#
# (test 178: a manual re-probe 229 s after boot brought up
# "Book Cover Keyboard Slim (EF-DX710)" with handlers sysrq kbd leds event2).
#
# This is the same pattern as the panel recovery: the sequencing is userspace
# policy, the driver still owns the hardware.  The service is bounded and
# always exits 0; a keyboard that cannot be recovered never blocks the boot.

set -u

POGO_SYSFS=${GTS9_POGO_SYSFS:-/sys/bus/i2c/devices/5-002a/rearm}
STAGE_HELPER=${GTS9_STAGE_HELPER:-/usr/libexec/gts9-record-debian-stage}
KMSG=${GTS9_POGO_KMSG:-/dev/kmsg}
SETTLE_SECONDS=${GTS9_POGO_SETTLE_SECONDS:-3}
READY_WAIT_SECONDS=${GTS9_POGO_READY_WAIT_SECONDS:-5}

report() {
	echo "gts9-pogo-recover: $*"
	if [ -w "$KMSG" ]; then
		printf 'gts9-pogo-recover: %s\n' "$*" > "$KMSG" 2>/dev/null || true
	fi
}

record_stage() {
	if [ -x "$STAGE_HELPER" ]; then
		"$STAGE_HELPER" "$@" || true
	fi
}

finish() {
	# finish STAGE MESSAGE [FAILURE]
	report "$2"
	if [ $# -ge 3 ] && [ -n "$3" ]; then
		record_stage --failure "$3" "$1"
	else
		record_stage "$1"
	fi
	exit 0
}

field() {
	# field NAME -> value from the rearm attribute, or an empty string
	sed -n "s/^$1=//p" "$POGO_SYSFS" 2>/dev/null | head -n 1
}

if [ ! -r "$POGO_SYSFS" ]; then
	finish pogo-absent 'the Pogo keyboard driver is not present'
fi

# The early probe gives up within 250 ms; give the rail and the MCU a moment
# before deciding that nothing is attached.
sleep "$SETTLE_SECONDS"

state=$(field state)
connect=$(field connect)
if [ "$state" = READY ]; then
	finish pogo-ok "keyboard is ${state} (connect=${connect:-?})"
fi

if [ "$connect" != 1 ]; then
	finish pogo-absent "no keyboard attached (state=${state:-?} connect=${connect:-?})"
fi

report "keyboard attached but the driver reports ${state:-?}; requesting a hard rearm"
if ! echo hard > "$POGO_SYSFS" 2>/dev/null; then
	finish pogo-recovery-failed 'the rearm attribute rejected the request' \
		pogo-recovery-failed
fi

waited=0
while [ "$waited" -lt "$READY_WAIT_SECONDS" ]; do
	if [ "$(field state)" = READY ]; then
		finish pogo-recovered \
			"keyboard READY after a hard rearm (connect=$(field connect))"
	fi
	sleep 1
	waited=$((waited + 1))
done

finish pogo-recovery-failed \
	"keyboard still $(field state) after ${READY_WAIT_SECONDS}s" \
	pogo-recovery-failed
