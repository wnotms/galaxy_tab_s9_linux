[Unit]
Description=X710 USB ACM serial console (ttyGS0, autologin root)
Documentation=file:/usr/share/doc/gts9/USB_SERIAL_CONSOLE.md
# Start only after the gadget exists, so agetty opens a tty that is really
# there.  The generic serial-getty@ttyGS0.service instead depends on
# dev-ttyGS0.device, which systemd starts waiting for at boot; when the gadget
# is created a little later, that device unit hits its 90 s timeout and the
# getty fails ("Timed out waiting for device dev-ttyGS0.device", seen on
# 2026-09-24).  This unit has no device dependency: gts9-usb-acm guarantees the
# node and the ordering.
After=gts9-usb-acm.service
Wants=gts9-usb-acm.service
Before=multi-user.target
# Failed starts must not trip the default start limit while the gadget settles.
StartLimitIntervalSec=0

[Service]
Type=simple
# Stop quickly at shutdown.  `agetty --autologin` spawns a login shell that agetty
# does not reap on SIGTERM, so systemd waits out the default TimeoutStopSec (90 s)
# and then SIGKILLs the whole cgroup.  On a poweroff the console prints
# "The system will power off now!" and then sits on a blinking cursor for up to a
# minute and a half before the rails actually drop - reported by the owner
# 2026-09-25, and visible in this repo's own journal:
#
#   gts9-acm-getty.service: State 'stop-sigterm' timed out. Killing.
#   gts9-acm-getty.service: Killing process 1456 (login) with signal SIGKILL.
#
# Nothing is lost by killing it sooner: ttyGS0 is a wired debug console, and any
# shell on it is gone by the time the system stops.  3 s is enough for agetty to
# exit cleanly when it can.  This directive belongs in [Service], not [Unit] -
# systemd ignores unknown keys in [Unit], which is why placement matters.
TimeoutStopSec=3
# --autologin root: the port is the wired debug console, and the host side of
# it is a cable the operator controls.
ExecStart=-/usr/sbin/agetty --autologin root --noclear ttyGS0 115200 vt100
# Restart until the gadget is up rather than failing the unit: a restarting
# unit keeps `systemctl --failed` clean and costs nothing.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
