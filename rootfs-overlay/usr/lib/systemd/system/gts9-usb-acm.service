[Unit]
Description=X710 USB debug link (configfs gadget: ECM network + ACM ports)
Documentation=file:/usr/share/doc/gts9/FAST_DEBUG_CHANNEL.md
After=local-fs.target
Before=serial-getty@ttyGS0.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/gts9-usb-acm
RemainAfterExit=yes
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
