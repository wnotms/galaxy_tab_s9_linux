[Unit]
Description=X710 USB debug link (NCM network for ssh + one serial port)
Documentation=file:/usr/share/doc/gts9/FAST_DEBUG_CHANNEL.md
After=local-fs.target
# The unit name keeps the historical "acm" because scripts, test records and the
# boot-stage history all refer to it.  What it provides changed on 2026-09-26: the
# gadget is now the NCM network ssh is reached over plus a single plain serial
# port (acm.usb0).  The second serial port (acm.usb1) is gone - it existed only to
# carry the kernel printk console, which was removed.
#
# The ordering is kept even though no getty runs on ttyGS0 any more: it costs
# nothing and it documents that the node appears from this unit rather than from
# dev-ttyGS0.device, which is what used to time out.
Before=serial-getty@ttyGS0.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/gts9-usb-acm
RemainAfterExit=yes
TimeoutStartSec=45

[Install]
WantedBy=multi-user.target
